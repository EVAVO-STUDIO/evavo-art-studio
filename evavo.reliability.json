{
  "schemaVersion": "1.4",
  "id": "evavo-art-studio",
  "repository": "EVAVO-STUDIO/evavo-art-studio",
  "defaultBranch": "main",
  "authority": "canonical-art-production-studio",
  "stack": "node-pnpm-creative-workspace",
  "packageManager": {
    "name": "pnpm",
    "exactVersion": "10.13.1",
    "lockfilePath": "pnpm-lock.yaml",
    "lockfilePolicy": "committed-frozen",
    "lockfilePresent": true,
    "install": "pnpm install --frozen-lockfile"
  },
  "dependencyLock": {
    "path": "pnpm-lock.yaml",
    "format": "pnpm-lockfile-v9",
    "generatedWith": {
      "node": "22.14.0",
      "pnpm": "10.13.1"
    },
    "committed": true,
    "frozenInstallationRequired": true,
    "immutableDuringValidation": true
  },
  "runtime": {
    "node": "22.14.0",
    "pnpm": "10.13.1",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "typescript": "^5.9.2"
  },
  "imageToolchain": {
    "python": "3.13.5",
    "requirements": "requirements-image-pipeline.txt",
    "pillow": "12.2.0",
    "install": "python -m pip install --disable-pip-version-check -r requirements-image-pipeline.txt",
    "verification": "python tools/verify_brass_creative_evaluation.py"
  },
  "pixelFontStudio": {
    "contract": "evavo.pixel-font-studio.v1",
    "requestSchema": "evavo.pixel-font-family-request.v1",
    "familySchema": "evavo.pixel-font-family.v1",
    "validationSchema": "evavo.pixel-font-validation.v1",
    "runtimeFormat": "AngelCode BMFont text plus RGBA PNG atlas",
    "sourceGrid": "evavo-5x7-v1",
    "externalFontBinaryUsed": false,
    "deterministic": true,
    "createOnly": true,
    "mcpDefaultMode": "read-only",
    "writeEnvironmentGateRequired": true,
    "writePerCallConfirmationRequired": true,
    "allowedRootBoundaryRequired": true,
    "independentValidation": {
      "allGeneratedPathsConstrainedToFamilyRoot": true,
      "canonicalRegularFilesRequired": true,
      "strictPngStructureAndCrcRequired": true,
      "bmFontHeaderCountPageCoverageAndBoundsRequired": true,
      "godotResourcePathBindingRequired": true,
      "exactRoleMapBindingRequired": true,
      "authorityReverificationRequired": true,
      "rehashDoesNotBypassValidation": true
    },
    "godotPolicy": {
      "minimumVersion": "4.0",
      "targetVersion": "4.6.2",
      "textureFilter": "nearest",
      "integerScaleOnly": true,
      "subpixelPositioning": false,
      "mipmaps": false
    },
    "productionFamilies": {
      "brass-brine-dos": {
        "request": "config/pixel-font-family.brass-brine.v1.json",
        "buildEntrypoint": "scripts/build-brass-brine-pixel-font-family.mjs",
        "requiredFaces": [
          "bb_dos_display",
          "bb_dos_ui",
          "bb_dos_ledger",
          "bb_dos_micro",
          "bb_dos_symbols"
        ],
        "requiredRuntimeRoles": [
          "title",
          "body",
          "button",
          "numeric_hud",
          "caption",
          "symbols",
          "weather",
          "wind"
        ],
        "resourceBasePath": "assets/fonts/evavo/brass-brine-dos",
        "minimumGodot": "4.6.2",
        "workflow": ".github/workflows/pixel-font-studio.yml",
        "workflowArtifactPrefix": "brass-brine-pixel-font-"
      }
    },
    "authority": {
      "providerExecution": false,
      "creativeApproval": false,
      "historicalApproval": false,
      "nativeGodotApproval": false,
      "candidatePromotion": false,
      "sourceMutation": false,
      "sourceDeletion": false,
      "targetRepositoryMutation": false,
      "gitCommit": false,
      "gitPush": false,
      "publication": false,
      "forcePush": false
    },
    "deliveryProfiles": {
      "review": {
        "includeSpecimens": true,
        "includeDetailedGlyphRecords": true
      },
      "runtime": {
        "includeSpecimens": false,
        "includeDetailedGlyphRecords": false
      }
    }
  },
  "workspace": {
    "manifest": "pnpm-workspace.yaml",
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "validation": [
    "python -m pip install --disable-pip-version-check -r requirements-image-pipeline.txt",
    "python tools/verify_brass_creative_evaluation.py",
    "node scripts/check-repository-toolchain.mjs",
    "node scripts/test-repository-toolchain.mjs",
    "pnpm install --frozen-lockfile",
    "node scripts/check-repository-toolchain.mjs",
    "node scripts/test-repository-toolchain.mjs",
    "node scripts/check-pixel-font-studio.mjs",
    "node --test scripts/pixel-font-brass-brine.test.mjs",
    "pnpm run build:domain",
    "pnpm typecheck",
    "pnpm test",
    "pnpm build",
    "git diff --exit-code -- pnpm-lock.yaml && git diff --exit-code && test -z \"$(git status --porcelain)\""
  ],
  "executedBaseline": {
    "workflow": ".github/workflows/ci.yml",
    "runId": "30544861146",
    "headSha": "52b6f0707f52a8c04e707cb521456f342d881d62",
    "conclusion": "success",
    "installedWithoutCommittedLockfile": true
  },
  "capabilityBoundary": {
    "validationMay": [
      "compile repository-owned protocols",
      "validate real media fixtures",
      "build packages and applications",
      "build original deterministic bitmap-font candidates",
      "build exact Brass and Brine display, UI, ledger, micro and symbol font evidence",
      "retain bounded source-validation evidence"
    ],
    "validationDoesNotAuthorize": [
      "live provider requests",
      "artifact promotion",
      "named reference mutation",
      "game repository mutation",
      "creative or historical approval",
      "native Godot approval",
      "production deployment",
      "credential mutation",
      "external communication"
    ]
  },
  "notes": [
    "The historical review-first baseline remains retained evidence; current installs are governed by the committed lockfile.",
    "The canonical pnpm lockfile is committed source and every install must use pnpm install --frozen-lockfile.",
    "Dependency updates require an explicit reviewed pnpm-lock.yaml change generated with Node.js 22.14.0 and pnpm 10.13.1.",
    "Raster evidence validation uses Python 3.13.5 and Pillow 12.2.0 exactly; evaluated pixels are decoded from the same retained bytes that are hashed.",
    "Pixel Font Studio generates original EVAVO bitmap glyphs without tracing, converting, subsetting or redistributing an external font binary.",
    "The canonical Brass & Brine family contains coordinated display, UI, ledger, micro and symbol faces and is rebuilt from source by the dedicated workflow.",
    "Every generated relative path, BMFont page, Godot resource and role binding is independently reopened and verified; rehashing redirected evidence does not create a pass.",
    "Validation runs automatically on pushes to main and may also be manually dispatched for the exact current main SHA.",
    "Superseded mainline validations are cancelled; a receipt is written only after the candidate is re-proven as current origin/main.",
    "Provider execution, promotion, game mutation and production effects remain separately authorised operations."
  ]
}

{
  "schemaVersion": "1.1",
  "id": "evavo-art-studio",
  "repository": "EVAVO-STUDIO/evavo-art-studio",
  "defaultBranch": "main",
  "authority": "canonical-art-production-studio",
  "stack": "node-pnpm-creative-workspace",
  "packageManager": {
    "name": "pnpm",
    "exactVersion": "10.13.1",
    "lockfilePath": "pnpm-lock.yaml",
    "lockfilePolicy": "committed-frozen",
    "lockfilePresent": true,
    "install": "pnpm install --frozen-lockfile"
  },
  "dependencyLock": {
    "path": "pnpm-lock.yaml",
    "format": "pnpm-lockfile-v9",
    "generatedWith": {
      "node": "22.14.0",
      "pnpm": "10.13.1"
    },
    "committed": true,
    "frozenInstallationRequired": true,
    "immutableDuringValidation": true
  },
  "runtime": {
    "node": "22.14.0",
    "pnpm": "10.13.1",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "typescript": "^5.9.2"
  },
  "workspace": {
    "manifest": "pnpm-workspace.yaml",
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "validation": [
    "node scripts/check-repository-toolchain.mjs",
    "node scripts/test-repository-toolchain.mjs",
    "pnpm install --frozen-lockfile",
    "node scripts/check-repository-toolchain.mjs",
    "node scripts/test-repository-toolchain.mjs",
    "pnpm run build:domain",
    "pnpm typecheck",
    "pnpm test",
    "pnpm build",
    "git diff --exit-code -- pnpm-lock.yaml && git diff --exit-code && test -z \"$(git status --porcelain)\""
  ],
  "executedBaseline": {
    "workflow": ".github/workflows/ci.yml",
    "runId": "30544861146",
    "headSha": "52b6f0707f52a8c04e707cb521456f342d881d62",
    "conclusion": "success",
    "installedWithoutCommittedLockfile": true
  },
  "capabilityBoundary": {
    "validationMay": [
      "compile repository-owned protocols",
      "validate real media fixtures",
      "build packages and applications",
      "retain bounded source-validation evidence"
    ],
    "validationDoesNotAuthorize": [
      "live provider requests",
      "artifact promotion",
      "named reference mutation",
      "production deployment",
      "credential mutation",
      "external communication"
    ]
  },
  "notes": [
    "The historical review-first baseline remains retained evidence; current installs are governed by the committed lockfile.",
    "The canonical pnpm lockfile is committed source and every install must use pnpm install --frozen-lockfile.",
    "Dependency updates require an explicit reviewed pnpm-lock.yaml change generated with Node.js 22.14.0 and pnpm 10.13.1.",
    "Validation runs automatically on pushes to main and may also be manually dispatched for the exact current main SHA.",
    "Superseded mainline validations are cancelled; a receipt is written only after the candidate is re-proven as current origin/main.",
    "Provider execution, promotion and production effects remain separately authorised operations."
  ]
}

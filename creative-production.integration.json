{
  "contractVersion": "evavo_creative_production_integration_v1",
  "repository": "EVAVO-STUDIO/evavo-art-studio",
  "role": "visual-direction-and-art-production",
  "studio": "art-studio",
  "planSchemaVersion": "1.0.0",
  "packetSchema": "schemas/creative-production-packet-v1.schema.json",
  "receiptSchema": "schemas/creative-production-receipt-v1.schema.json",
  "gateReceiptSchema": "schemas/creative-production-gate-receipt-v1.schema.json",
  "entrypoints": {
    "admit": "node tools/game_production_intake_cli.mjs",
    "library": "scripts/game-production-intake.mjs#admitGameProductionPlan",
    "emitReceipt": "scripts/game-production-intake.mjs#createGameProductionReceipt"
  },
  "upstreamRepositories": ["EVAVO-STUDIO/game-design-studio", "EVAVO-STUDIO/environment-studio"],
  "downstreamRepositories": ["EVAVO-STUDIO/evavo-3d-studio", "EVAVO-STUDIO/evavo-image-enhancement-studio"],
  "requirements": {
    "reviewedGateReceipts": true,
    "bareGateIdsAccepted": false,
    "reviewedPredecessorReceipts": true,
    "completePredecessorReceiptChain": true,
    "exactArtifactRevisionDigest": true,
    "operationWhitelist": true,
    "humanCreativeApprovalRemainsSeparate": true
  },
  "authority": {
    "executesOnAdmission": false,
    "grantsCreativeApproval": false,
    "mutatesConsumerRepository": false,
    "publishes": false
  }
}

# EVAVO Docs Suite server-only production configuration.
# Never prefix any of these values with NEXT_PUBLIC_ and never commit real credentials.

# Shared only with the EVAVO hub. Signs and verifies the two-minute cross-app handoff.
EVAVO_CLIENT_APP_LAUNCH_SECRET=

# Docs Suite only. Must differ from EVAVO_CLIENT_APP_LAUNCH_SECRET.
# Signs the eight-hour workspace session and 15-minute automation grants.
EVAVO_DOCS_PRIVATE_SIGNING_SECRET=

# Canonical production request host. Request-host equality is still checked at runtime.
EVAVO_DOCS_RUNTIME_HOST=docs.evavo.com.au

# Protected Writing Studio Book candidate runtime.
# Configure an HTTPS origin only; Docs Suite appends /api/v1/book-candidate.
# The token remains server-side and must differ from Docs Suite signing and hub secrets.
# The transport can use at most 280 seconds under the 300-second hosted route and
# still requires at least ten seconds beyond each requested provider timeout.
EVAVO_WRITING_STUDIO_BOOK_CANDIDATE_URL=
EVAVO_WRITING_STUDIO_BOOK_CANDIDATE_TOKEN=
EVAVO_WRITING_STUDIO_BOOK_CANDIDATE_TIMEOUT_MS=280000
EVAVO_WRITING_STUDIO_BOOK_CANDIDATE_MAX_RESPONSE_BYTES=4000000

# Protected Art Studio Book Art plan-translation runtime.
# Configure the HTTPS Art Studio origin only; Docs Suite appends one of the two
# fixed legacy cover/illustration translation paths. This read-only shadow call
# performs no provider execution, artifact write, selection or promotion.
EVAVO_ART_STUDIO_BOOK_ART_URL=
EVAVO_ART_STUDIO_BOOK_ART_TOKEN=
EVAVO_ART_STUDIO_BOOK_ART_TIMEOUT_MS=120000
EVAVO_ART_STUDIO_BOOK_ART_MAX_RESPONSE_BYTES=4000000

# Durable one-time handoff redemption store.
# Provision Upstash Redis through the Vercel Marketplace or Upstash directly.
# Use the HTTPS REST origin and a server-only standard token with write permission.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

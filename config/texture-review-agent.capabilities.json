{
  "schemaVersion": "1.5",
  "id": "evavo-texture-review-agent",
  "purpose": "Map-aware texture/PBR review, coherent material-set validation, topology-aware UV/OBJ assurance, explicit texture preprocessing, sampling-aware tile proofs and guarded Godot ORM packing.",
  "entrypoint": "tools/texture_review_mcp.mjs",
  "protocol": "mcp-stdio-2025-03-26",
  "buildPrerequisite": "pnpm --filter @evavo/art-media build",
  "environment": {
    "EVAVO_TEXTURE_REVIEW_ALLOWED_ROOTS": {
      "requiredForLocalReadsAndWrites": true,
      "description": "Platform-delimited canonical roots the texture review server may read textures/OBJ meshes from and create derived outputs within."
    },
    "EVAVO_TEXTURE_REVIEW_ALLOW_WRITES": {
      "requiredForDerivedWrites": true,
      "value": "true"
    }
  },
  "mapKinds": [
    "base-color",
    "normal-tangent",
    "roughness",
    "metallic",
    "ambient-occlusion",
    "height",
    "specular",
    "emissive",
    "opacity",
    "orm-packed"
  ],
  "proofSampling": {
    "default": "continuous",
    "continuous": "Lanczos3 is used only when the diagnostic tile must be reduced; this avoids artificial blockiness on continuous-tone textures.",
    "nearest": "Explicit opt-in for pixel art or exact texel/block inspection."
  },
  "materialSet": {
    "matchingDimensionsByDefault": true,
    "powerOfTwoPolicyDefault": "warn",
    "supportsExpectedMapRoles": true,
    "duplicateRolesRejected": true
  },
  "uvAssurance": {
    "triangleContract": true,
    "wavefrontObj": true,
    "maximumTriangles": 5000,
    "orientationConventionDefault": "majority",
    "meshVertexKeysSupported": true,
    "objVertexKeysAutomatic": true,
    "connectivityModes": ["mesh-aware", "uv-only-fallback", "mixed-conservative"],
    "checks": [
      "degenerate-uv-triangles",
      "out-of-range-uv-coordinates",
      "accidental-overlap",
      "explicit-overlap-groups",
      "orientation-relative-mirrored-winding",
      "topology-aware-uv-islands",
      "atlas-boundary-padding",
      "inter-island-padding-in-output-texels",
      "world-space-texel-density"
    ],
    "sourceMutationAllowed": false,
    "missingObjUvsInvented": false
  },
  "preprocessing": {
    "normalYConvention": {
      "tool": "evavo_convert_tangent_normal_y_convention",
      "transformation": "G=255-G",
      "preservedChannels": ["r", "b", "a"],
      "silentConversionAllowed": false
    },
    "opacityToAlbedoAlpha": {
      "tool": "evavo_compose_opacity_into_albedo_alpha",
      "albedoRgbPreservedExactly": true,
      "resizeAllowed": false,
      "silentCompositionAllowed": false
    },
    "specular": {
      "automaticConversionAllowed": false,
      "route": "Re-author for metallic/roughness or deliberately use a reviewed custom shader."
    }
  },
  "godot": {
    "normalConvention": "OpenGL X+ Y+ Z+",
    "ormChannelContract": "R=ambient-occlusion,G=roughness,B=metallic",
    "ormDefaults": {
      "ambientOcclusion": 255,
      "roughness": 255,
      "metallic": 0
    },
    "materials": ["StandardMaterial3D", "ORMMaterial3D"]
  },
  "tools": [
    "evavo_texture_review_capabilities",
    "evavo_review_texture_map",
    "evavo_review_texture_set",
    "evavo_review_uv_layout",
    "evavo_review_obj_uv_layout",
    "evavo_convert_tangent_normal_y_convention",
    "evavo_compose_opacity_into_albedo_alpha",
    "evavo_create_texture_tile_proof",
    "evavo_pack_godot_orm_texture"
  ],
  "guarantees": {
    "sourceMutationAllowed": false,
    "derivedOutputsCreateOnly": true,
    "derivedWritesRequireExplicitConfirmation": true,
    "continuousTextureProofsAvoidForcedNearestResampling": true,
    "strictScalarValidationByDefault": true,
    "silentNormalChannelFlip": false,
    "silentOpacityComposition": false,
    "silentPackedMapRepacking": false,
    "explicitOrmPackingOnly": true,
    "uvReviewReadOnly": true,
    "topologyPreferredOverCoordinateGuessing": true,
    "claimsAiOriginDetection": false
  }
}

{
  "schemaVersion": "1.1.0",
  "profileId": "mon-terrain-source-family-v1",
  "consumer": "moonstone-wales",
  "purpose": "Generate controlled source masters for later deterministic seamless mastering and tile-map admission.",
  "sourceMaster": {
    "width": 1024,
    "height": 1024,
    "background": "opaque",
    "projection": "top-down continuous surface",
    "lighting": "flat diffuse, no strong directional hero shadow",
    "allowPromptSeamlessClaim": false,
    "mustRemainUnapprovedUntilProof": true,
    "sourcePreservationRequired": true,
    "candidateHashRequired": true,
    "promptPacketRequired": true
  },
  "familyRules": {
    "minimumCandidatesPerMaterial": 8,
    "preferredCandidatesPerMaterial": 10,
    "targetApprovedVariants": 8,
    "minimumApprovedVariants": 6,
    "maximumApprovedVariants": 12,
    "lock": [
      "material identity",
      "scale",
      "projection",
      "detail density",
      "palette/value envelope",
      "lighting grammar"
    ],
    "variationAllowed": [
      "microtexture",
      "small stones",
      "minor colour shift",
      "subtle moss density",
      "subtle wear",
      "restrained vegetation density"
    ],
    "variationForbidden": [
      "large unique boulder",
      "recognisable repeated flower cluster",
      "large hero heather clump",
      "large puddle",
      "building fragment",
      "road boundary",
      "shoreline",
      "cliff face",
      "dramatic light patch",
      "obvious centred focal feature",
      "painted tile border"
    ]
  },
  "separateOverlayFamilies": [
    "heather-clusters",
    "gorse",
    "bracken",
    "grass-tufts",
    "rock-scatter",
    "roots",
    "branches",
    "puddles",
    "mud-ruts",
    "footprints",
    "hoofprints",
    "wheel-ruts",
    "battlefield-debris"
  ],
  "handoff": {
    "textureStudioProfile": "mon-painted-2_5d-surface-production-v1",
    "tileMapStudioProfile": "mon-transition-topology-v1",
    "tileMapStudioProofs": [
      "seam-check",
      "offset-proof",
      "seam-master-offset",
      "tiling-proof",
      "family-edge-check",
      "family-proof",
      "native-scale-godot-proof"
    ],
    "approvalRule": "No source becomes seamless-approved from generation alone."
  }
}

{
  "schema": "evavo.layered-production.godot-git-push-verifier.v1",
  "version": 1,
  "protocolVersion": "2026-08-13.3",
  "description": "Read-only independent verification boundary for one exact layered Godot commit receipt, its bound push receipt, their current local and remote refs, and one closed-contract verification receipt.",
  "entrypoint": "scripts/layered-godot-git-push-verifier.mjs",
  "requirements": {
    "requiresExactCurrentCommitReceipt": true,
    "requiresClosedCommitReceiptContract": true,
    "requiresCommitReceiptSelfHash": true,
    "requiresCommitAndPushReceiptLineageParity": true,
    "requiresCommitAndPushGitIdentityParity": true,
    "requiresExactCurrentPushReceipt": true,
    "requiresClosedPushReceiptContract": true,
    "requiresPushReceiptSelfHash": true,
    "requiresOutcomeCommandAuthorityParity": true,
    "requiresImmutableInputSnapshot": true,
    "requiresSynchronousDependencyCaptureBeforeAsyncBoundary": true,
    "rejectsProxyInputsDependenciesAndResults": true,
    "rejectsAccessorsWithoutInvocation": true,
    "rejectsUnsupportedFieldsAtEveryReceiptBoundary": true,
    "requiresExactRepositoryRoot": true,
    "requiresCleanLocalRepository": true,
    "requiresExactLocalHeadParentTreeAndBranch": true,
    "requiresExactHttpsGithubOrigin": true,
    "requiresOriginRepositoryAndUrlIdentityParity": true,
    "requiresTwoPhaseLocalAndRemoteVerification": true,
    "requiresRemoteRefEqualReceiptCommit": true,
    "requiresRemoteStabilityAcrossVerification": true,
    "requiresClosedReadOnlyGitCommandSet": true,
    "requiresOwnedGitOutputBuffers": true,
    "rejectsSharedGitOutputBuffers": true,
    "maximumGitOutputBytes": 2097152,
    "maximumLocalGitTimeoutMs": 30000,
    "maximumNetworkGitTimeoutMs": 120000,
    "emitsSelfHashedVerificationReceipt": true,
    "requiresClosedVerificationReceiptContract": true,
    "requiresGeneratedVerificationReceiptReadmission": true,
    "requiresVerificationReceiptSourceLineageParity": true
  },
  "authority": {
    "targetRepositoryRead": true,
    "targetRepositoryMutation": false,
    "gitRead": true,
    "gitNetworkRead": true,
    "gitObjectWrite": false,
    "gitIndexWrite": false,
    "gitCommit": false,
    "gitRefUpdate": false,
    "gitPush": false,
    "gitTagPush": false,
    "forcePush": false,
    "deployment": false,
    "releasePublication": false
  }
}

{
  "schema": "evavo.layered-production.godot-git-operator.v1",
  "version": 1,
  "protocolVersion": "2026-08-13.1",
  "description": "Explicit commit-only Git operator with synchronous dependency capture and owned exact-byte verifier evidence for one current read-only-reviewed layered Godot 4.6.2 handoff. Push remains a separate authority.",
  "entrypoint": "scripts/layered-godot-git-operator.mjs",
  "requirements": {
    "requiresCurrentRepositoryReview": true,
    "requiresCurrentRepositoryReviewProtocol": "2026-08-12.1",
    "requiresCurrentHandoffGateProtocolSeam": true,
    "requiresExactSevenResourceCoverage": true,
    "requiresExplicitCommitAuthorization": true,
    "requiresPushAuthorizationFalse": true,
    "requiresForcePushAuthorizationFalse": true,
    "requiresSingleLineCommitMessage": true,
    "requiresImmutableInputSnapshot": true,
    "requiresSynchronousDependencyCaptureBeforeAsyncBoundary": true,
    "rejectsProxyDependencyObjects": true,
    "rejectsDependencyAccessorsWithoutInvocation": true,
    "rejectsUnsupportedDependencyFields": true,
    "requiresNonProxyDependencyFunctions": true,
    "requiresCapturedWorkspaceRootResult": true,
    "requiresVerifierResultCaptureBeforeReviewAwait": true,
    "requiresVerifierOwnedResourceBufferCopy": true,
    "rejectsSharedVerifierBuffers": true,
    "requiresVerifiedResourceContentByteHashAgreement": true,
    "requiresCurrentReviewImmutableSnapshot": true,
    "requiresCapturedStableFileReadResults": true,
    "requiresCapturedGitSubprocessResults": true,
    "requiresExactRepositoryReviewReAdmissionImmediatelyBeforeMutation": true,
    "requiresRawBlobStaging": true,
    "rawBlobCommand": "git hash-object -w --stdin",
    "exactIndexCommand": "git update-index --add --cacheinfo",
    "forbidsGitAddAll": true,
    "requiresNoActiveFilterWorkingTreeEncodingOrIdentTransform": true,
    "requiresHeadAndBranchStableBeforeCommit": true,
    "requiresExactIndexPathSet": true,
    "requiresExactStagedBlobBytes": true,
    "requiresExactWorkingTreeBytesAfterStaging": true,
    "requiresNoUnrelatedUnstagedOrUntrackedFiles": true,
    "requiresHooksDisabled": true,
    "requiresCommitSigningDisabled": true,
    "requiresVerbatimCommitMessage": true,
    "requiresDirectSingleParentCommit": true,
    "requiresExactCommittedPathSet": true,
    "requiresAllSevenHeadResourcesEqualApprovedBytes": true,
    "requiresCleanRepositoryAfterCommit": true,
    "requiresIndexPreimageRollbackOnSafePreCommitFailure": true,
    "refusesRollbackOnConcurrentSamePathIndexDrift": true,
    "refusesAutomaticRollbackAfterUnverifiedHeadMovementFromCommit": true,
    "maximumGitOutputBytes": 2097152,
    "defaultGitTimeoutMs": 30000
  },
  "outcomes": {
    "changedHandoff": "committed",
    "alreadyIntegratedHandoff": "already-integrated"
  },
  "authority": {
    "targetRepositoryRead": true,
    "targetRepositoryWorkingTreeWrite": false,
    "gitObjectWrite": true,
    "gitIndexWrite": true,
    "gitHookExecution": false,
    "gitCommit": true,
    "gitRefUpdate": true,
    "gitPush": false,
    "deployment": false,
    "publication": false,
    "forcePush": false
  }
}

{
  "schemaVersion": 2,
  "kind": "evavo-automation-fabric-client",
  "contractVersion": 3,
  "client": "evavo-art-studio",
  "role": "governed-art-production-media-validation-and-provider-control",
  "canonicalRepository": "EVAVO-STUDIO/evavo-local-storage",
  "canonicalStarter": "START-EVAVO-AUTOMATION-FABRIC.ps1",
  "canonicalManifest": "config/automation-fabric-capabilities.json",
  "minimumLocalStorageVersion": "0.36.0",
  "poolId": "windows-local",
  "primaryNodeId": "windows-primary",
  "activation": {
    "installedRequired": true,
    "liveRequired": true,
    "reachableRequired": true,
    "healthyHeartbeatAloneIsSufficient": false,
    "exactNodeRoundTripRequired": true,
    "capabilityRoutedPoolRoundTripRequired": true,
    "requestToReceiptCorrelationRequired": true,
    "matchingReceiptCount": 1,
    "duplicateExecutionAllowed": false,
    "readOnlyReachabilityAction": "storage.capabilities",
    "sourceMustBeExactCleanResolvedOnlineMain": true,
    "receiptRequiredBeforeRoutineUse": true
  },
  "mailboxGeneration": {
    "residentWorkersUseGenerationEpoch": true,
    "autoscalerUsesGenerationEpoch": true,
    "burstWorkersInheritGenerationEpoch": true,
    "capacityPlannerIgnoresPreEpochIssues": true,
    "olderIssuesDeleted": false,
    "olderIssuesClosedAutomatically": false,
    "olderIssuesRemainRecoverable": true,
    "staleBacklogMayStarveNewGeneration": false
  },
  "routing": {
    "preferWorkerFabric": true,
    "routeByRequiredCapabilities": true,
    "specificNodeOverridesPool": true,
    "poolClaimsAreAtomic": true,
    "workerLeasesRenewDuringLongJobs": true,
    "oneProcessPerWorker": true,
    "residentWorkers": 2,
    "maximumLogicalWorkers": 10,
    "excessDemandPolicy": "queue-not-spawn",
    "queuedDoesNotMeanCompleted": true
  },
  "clientResponsibilities": {
    "fileFirstPowerShell": true,
    "powershellGuardRequired": true,
    "nativePowerShellParseRequired": true,
    "explicitChildExitCodeRequired": true,
    "governedArtPlanRequired": true,
    "sourceHashesRevalidated": true,
    "providerExecutionRequiresSeparateGate": true,
    "bytesNeverFlowThroughMcp": true,
    "guardedMainPublicationRequired": true,
    "declaredPathsOnly": true,
    "remoteMainRecheckBeforePush": true
  },
  "acceleratorRouting": {
    "resourceGovernorRepository": "EVAVO-STUDIO/evavo-local-compute",
    "minimumLocalComputeVersion": "0.13.0",
    "resourceGovernor": "evavo-local-compute-resource-plan",
    "heavyAiExactNode": "windows-general-1",
    "heavyAiPoolTargetingForbidden": true,
    "requiredCapabilities": [
      "resource-governor",
      "gpu-probe",
      "ai-inference"
    ],
    "hardwareCapabilityMustBeProbedAtJobStart": true,
    "gpuHeavyJobConcurrency": 1,
    "exclusiveGpuLeaseRequired": true,
    "preferIsolatedProcessPerHeavyJob": true,
    "minimumFreeVramHeadroomMiB": 768,
    "minimumFreeSystemRamHeadroomGiB": 4,
    "maximumModelExecutorVramFraction": 0.9,
    "maximumModelRamFraction": 0.72,
    "cpuOffloadAllowed": true,
    "memoryMappedWeightsPreferred": true,
    "quantizedWeightsPreferredWhenNeeded": true,
    "quantizedKvCacheAllowedWhenSupported": true,
    "contextAndBatchMayBeReducedToAvoidOom": true,
    "pagefileAsPrimaryModelMemory": false,
    "unifiedMemoryOversubscription": "fallback-only-runtime-supported",
    "modelProcessExitIsPrimaryGpuMemoryCleanup": true,
    "modelUnloadAfterHeavyJob": true,
    "cudaCacheCleanupAfterHeavyJob": true,
    "gpuCapabilityClaimsRequireLiveProbe": true,
    "heavyAiJobsRequireResourcePlan": true,
    "heavyAiJobsRouteToResourceGovernorWorker": true,
    "providerExecutionGateStillRequired": true
  },
  "repositoryMutation": {
    "operatorRepository": "EVAVO-STUDIO/evavo-github-mcp",
    "entrypoint": "control-plane/agent-workspace-mcp.mjs",
    "transport": "stdio",
    "publicRemoteSurface": "read-only",
    "structuredMutationRequired": true,
    "rawGitByDefault": false,
    "rawGithubByDefault": false
  },
  "publication": {
    "operatorRepository": "EVAVO-STUDIO/evavo-development-studio",
    "operator": "scripts/mainline-publish.mjs",
    "normalPushOnly": true,
    "liveRemoteRecheck": true,
    "declaredPathsOnly": true,
    "exactHeadRequired": true,
    "exactStatusRequired": true,
    "remoteShaVerification": true,
    "forcePush": false,
    "resetHard": false,
    "clean": false,
    "stashAsRecovery": false,
    "rebase": false
  },
  "manualTerminalRelay": {
    "requiredAfterReachabilityAcceptance": false,
    "oneTimeRecoveryBootstrapPermittedWhenFabricUnreachable": true,
    "routineCommandsMustNotBeDelegatedToUser": true
  },
  "executionEvidence": {
    "workerReceiptIsPublicationEvidence": false,
    "queuedWorkIsCompleted": false,
    "localExecutionIsPublicationPermission": false,
    "providerReceiptIsGitPublicationEvidence": false,
    "resourcePlanIsProviderAuthorization": false,
    "hardwareProbeIsCreativeApproval": false,
    "validationIsCreativeApproval": false,
    "validationIsRuntimePromotion": false
  },
  "approvedRoots": [
    "C:\\GitRepos",
    "C:\\Downloads",
    "C:\\BEESTATION",
    "approved-discovered-external-roots"
  ],
  "safety": {
    "forcePush": false,
    "gitResetHard": false,
    "gitClean": false,
    "gitStashAsRecovery": false,
    "rebasePublication": false,
    "permanentDelete": false,
    "downloadSuccessAloneAuthorizesExecution": false,
    "secretEnvironmentCallerOverride": false
  }
}

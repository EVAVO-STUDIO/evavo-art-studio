{
  "schema": "evavo.artist-workspace-agent-suite.v1",
  "version": 1,
  "description": "Canonical path-only MCP deployment for persistent project-art workspaces and exact external asset ingest.",
  "configuration": "config/mcp.project-art-workspace.windows.example.json",
  "servers": [
    {
      "id": "evavo-project-art-workspace",
      "entrypoint": "tools/project_art_workspace_mcp.mjs",
      "workspaceRootsEnvironment": "EVAVO_ART_WORKSPACE_ROOTS",
      "writeGateEnvironment": "EVAVO_ART_WORKSPACE_MCP_ALLOW_WRITE",
      "defaultWriteEnabled": false,
      "toolGroups": [
        "project-intelligence",
        "deterministic-sandbox",
        "reference-planning",
        "temporary-intake",
        "sprite-atlas",
        "persistent-workspace-create",
        "persistent-workspace-snapshot",
        "evavo-storage-handoff"
      ]
    },
    {
      "id": "evavo-project-art-workspace-ingest",
      "entrypoint": "tools/project_art_workspace_ingest_mcp.mjs",
      "workspaceRootsEnvironment": "EVAVO_ART_WORKSPACE_INGEST_ROOTS",
      "sourceRootsEnvironment": "EVAVO_ART_WORKSPACE_INGEST_SOURCE_ROOTS",
      "writeGateEnvironment": "EVAVO_ART_WORKSPACE_INGEST_MCP_ALLOW_WRITE",
      "defaultWriteEnabled": false,
      "toolGroups": [
        "external-source-capabilities",
        "external-source-plan-compilation",
        "atomic-persistent-workspace-ingest"
      ]
    }
  ],
  "flows": [
    {
      "id": "chat-or-claude-image-to-persistent-workspace",
      "steps": [
        "evavo_art_workspace_ingest_capabilities",
        "evavo_art_compile_workspace_ingest",
        "evavo_art_run_workspace_ingest",
        "evavo_art_compile_workspace_snapshot",
        "evavo_art_run_workspace_snapshot"
      ]
    },
    {
      "id": "persistent-workspace-to-evavo-storage",
      "steps": [
        "evavo_art_prepare_storage_handoff",
        "independently-authorized-evavo-storage-ingest"
      ]
    },
    {
      "id": "persistent-workspace-art-production",
      "steps": [
        "evavo_art_compile_sandbox",
        "evavo_art_run_sandbox",
        "evavo_art_compile_atlas",
        "evavo_art_run_atlas",
        "separate-visual-review-and-promotion"
      ]
    }
  ],
  "authority": {
    "bytesFlowThroughMcp": false,
    "arbitraryShell": false,
    "sourceMutation": false,
    "sourceDeletion": false,
    "providerExecution": false,
    "candidateApproval": false,
    "candidatePromotion": false,
    "storageWrite": false,
    "repositoryMutation": false,
    "gitPublication": false,
    "deployment": false,
    "publication": false,
    "forcePush": false
  }
}

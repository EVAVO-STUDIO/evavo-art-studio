{
  "schema": "evavo.artist-workspace-agent-suite.v1",
  "version": 1,
  "description": "Canonical path-only MCP deployment for persistent project-art workspaces, exact external asset ingest, content-addressed workspace discovery and crash-resumable production checkpoints.",
  "configuration": "config/mcp.project-art-workspace.windows.example.json",
  "servers": [
    {
      "id": "evavo-project-art-workspace",
      "entrypoint": "tools/project_art_workspace_mcp.mjs",
      "workspaceRootsEnvironment": "EVAVO_ART_WORKSPACE_ROOTS",
      "writeGateEnvironment": "EVAVO_ART_WORKSPACE_MCP_ALLOW_WRITE",
      "defaultWriteEnabled": false,
      "toolGroups": [
        "project-intelligence",
        "deterministic-sandbox",
        "reference-planning",
        "temporary-intake",
        "sprite-atlas",
        "persistent-workspace-create",
        "persistent-workspace-snapshot",
        "evavo-storage-handoff"
      ]
    },
    {
      "id": "evavo-project-art-workspace-ingest",
      "entrypoint": "tools/project_art_workspace_ingest_mcp.mjs",
      "workspaceRootsEnvironment": "EVAVO_ART_WORKSPACE_INGEST_ROOTS",
      "sourceRootsEnvironment": "EVAVO_ART_WORKSPACE_INGEST_SOURCE_ROOTS",
      "writeGateEnvironment": "EVAVO_ART_WORKSPACE_INGEST_MCP_ALLOW_WRITE",
      "defaultWriteEnabled": false,
      "toolGroups": [
        "external-source-capabilities",
        "external-source-plan-compilation",
        "atomic-persistent-workspace-ingest"
      ]
    },
    {
      "id": "evavo-project-art-workspace-catalog",
      "entrypoint": "tools/project_art_workspace_catalog_mcp.mjs",
      "workspaceRootsEnvironment": "EVAVO_PERSISTENT_CATALOG_ROOTS",
      "writeGateEnvironment": "EVAVO_PERSISTENT_CATALOG_MCP_ALLOW_WRITE",
      "defaultWriteEnabled": false,
      "toolGroups": [
        "workspace-catalog-capabilities",
        "content-addressed-workspace-inventory",
        "bounded-workspace-query",
        "exact-duplicate-detection",
        "workspace-drift-verification"
      ]
    },
    {
      "id": "evavo-project-art-workspace-jobs",
      "entrypoint": "tools/project_art_workspace_jobs_mcp.mjs",
      "workspaceRootsEnvironment": "EVAVO_ART_WORKSPACE_JOB_ROOTS",
      "writeGateEnvironment": "EVAVO_ART_WORKSPACE_JOBS_MCP_ALLOW_WRITE",
      "defaultWriteEnabled": false,
      "toolGroups": [
        "workspace-job-capabilities",
        "exact-job-plan-compilation",
        "append-only-job-publication",
        "lease-bounded-agent-claim",
        "hash-chained-checkpoints",
        "crash-resume-and-drift-verification"
      ]
    }
  ],
  "flows": [
    {
      "id": "chat-or-claude-image-to-persistent-workspace",
      "steps": [
        "evavo_art_workspace_ingest_capabilities",
        "evavo_art_compile_workspace_ingest",
        "evavo_art_run_workspace_ingest",
        "evavo_art_compile_workspace_snapshot",
        "evavo_art_run_workspace_snapshot"
      ]
    },
    {
      "id": "persistent-workspace-discovery-and-drift",
      "steps": [
        "evavo_art_workspace_catalog_capabilities",
        "evavo_art_compile_workspace_catalog",
        "evavo_art_run_workspace_catalog",
        "evavo_art_query_workspace_catalog",
        "evavo_art_verify_workspace_catalog"
      ]
    },
    {
      "id": "resumable-persistent-workspace-production",
      "steps": [
        "evavo_art_workspace_job_capabilities",
        "evavo_art_compile_workspace_job",
        "evavo_art_create_workspace_job",
        "evavo_art_inspect_workspace_job",
        "evavo_art_checkpoint_workspace_job",
        "bounded-existing-art-tool-from-ready-job-step",
        "evavo_art_checkpoint_workspace_job",
        "evavo_art_inspect_workspace_job"
      ]
    },
    {
      "id": "persistent-workspace-to-evavo-storage",
      "steps": [
        "evavo_art_prepare_storage_handoff",
        "independently-authorized-evavo-storage-ingest"
      ]
    },
    {
      "id": "persistent-workspace-art-production",
      "steps": [
        "evavo_art_compile_sandbox",
        "evavo_art_run_sandbox",
        "evavo_art_compile_atlas",
        "evavo_art_run_atlas",
        "separate-visual-review-and-promotion"
      ]
    }
  ],
  "authority": {
    "bytesFlowThroughMcp": false,
    "arbitraryShell": false,
    "sourceMutation": false,
    "sourceDeletion": false,
    "providerExecution": false,
    "candidateApproval": false,
    "candidatePromotion": false,
    "storageWrite": false,
    "repositoryMutation": false,
    "gitPublication": false,
    "deployment": false,
    "publication": false,
    "forcePush": false
  }
}

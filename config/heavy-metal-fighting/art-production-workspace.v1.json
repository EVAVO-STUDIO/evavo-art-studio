    "sources",
    "working",
    "versions",
    "masks",
    "scratch",
    "review",
    "masters",
    "exports",
    "manifests",
    "journals"
  ],
  "subjects": {
    "pilots": ["branka-kovac", "miho-tagawa", "esi-quartey", "parvaneh-razi"],
    "frames": ["bastion", "viper", "citadel", "mirage"],
    "arenas": ["foundry-nine", "reactor-spine", "orbital-dock", "ash-citadel"]
  },
  "directoryTemplates": {
    "fixed": [
      "sources/authority",
      "sources/reference-ingest",
      "sources/runtime-manifests",
      "working/style/north-star",
      "working/style/palette",

      "working/ui/main-menu",
      "working/ui/pilot-select",
      "working/ui/frame-select",
      "working/ui/versus",
      "working/ui/hud",
      "working/ui/service-bay",
      "working/ui/records",
      "working/ui/options",
      "working/ui/results",
      "working/ui/ending",
      "working/intro/cels",
      "working/intro/overlays",
      "working/intro/timing",
      "working/fx/universal",
      "working/fx/contact",
      "working/fx/core",
      "working/fx/system",
      "scratch/provider",
      "scratch/composites",
      "scratch/reference-tests",
      "scratch/palette-tests",
      "review/style-proof",
      "review/native-scale",
      "review/grayscale",
      "review/silhouette",
      "review/mirror",
      "review/stage-composites",
      "review/batches",
      "masters/pilots",
      "masters/frames",
      "masters/arenas",
      "masters/ui",
      "masters/fx",
      "masters/intro",
      "exports/runtime/frames",
      "exports/runtime/pilots",
      "exports/runtime/arenas",
      "exports/runtime/ui",
      "exports/runtime/fx",
      "exports/runtime/intro",
      "manifests/authority",
      "manifests/contracts",
      "manifests/census",
      "manifests/batches",
      "manifests/receipts",
      "manifests/validation",
      "manifests/delivery",
      "journals/decisions",
      "journals/rejections",
      "journals/repairs",
      "journals/batches"
    ],
    "perPilot": [
      "working/pilots/{pilot}/identity",
      "working/pilots/{pilot}/portraits",
      "working/pilots/{pilot}/select",
      "working/pilots/{pilot}/hud",
      "working/pilots/{pilot}/comms",
      "working/pilots/{pilot}/overdrive",
      "working/pilots/{pilot}/service",
      "working/pilots/{pilot}/cockpit",
      "masks/pilots/{pilot}",
      "review/pilots/{pilot}",
      "masters/pilots/{pilot}"
    ],
    "perFrame": [
      "working/frames/{frame}/construction",
      "working/frames/{frame}/landmarks",
      "working/frames/{frame}/hardpoints",
      "working/frames/{frame}/palette",
      "working/frames/{frame}/sprites/neutral-locomotion",
      "working/frames/{frame}/sprites/defence-reactions",
      "working/frames/{frame}/sprites/throws",
      "working/frames/{frame}/sprites/normals",
      "working/frames/{frame}/sprites/specials-overdrive",
      "working/frames/{frame}/sprites/core-entrance-result",
      "working/frames/{frame}/fx",
      "working/frames/{frame}/damage",
      "working/fx/frame/{frame}",
      "masks/frames/{frame}",
      "review/frames/{frame}/construction",
      "review/frames/{frame}/sprites",
      "review/frames/{frame}/fx",
      "masters/frames/{frame}",
      "exports/runtime/frames/{frame}"
    ],
    "perArena": [
      "working/arenas/{arena}/far",
      "working/arenas/{arena}/mid",
      "working/arenas/{arena}/play-plane",
      "working/arenas/{arena}/foreground",
      "working/arenas/{arena}/lighting",
      "working/arenas/{arena}/ambient",
      "working/arenas/{arena}/damage",
      "working/arenas/{arena}/hazard",
      "review/arenas/{arena}",
      "masters/arenas/{arena}",
      "exports/runtime/arenas/{arena}"
    ]
  },
  "workspaceRules": [
    "sources are immutable reference and authority inputs",
    "working contains only current editable candidates and approved working copies",
    "versions are append-only and remain owned by the persistent Artist Workspace runtime",
    "scratch is disposable and never counts as approved source art",
    "review contains evidence and composites, never the only copy of an approved asset",
    "masters contains named-human-approved production masters only",
    "exports are deterministic derivatives of approved masters",
    "manifests and receipts bind every batch and delivery to exact source hashes",
    "journals record decisions, rejections and repairs without rewriting history"
  ],
  "fileNaming": {
    "lowercaseKebabCase": true,
    "spriteCelPattern": "{frame}-{bank}-c{cel:03}.png",
    "pilotAssetPattern": "{pilot}-{state}.png",
    "arenaLayerPattern": "{arena}-{layer}-{variant}.png",
    "batchIdPattern": "hmf-b{sequence:04}-{family}-{subject}-{group}",
    "candidatePattern": "{unit}-cand-{candidate:02}.png",
    "masterPattern": "{unit}-master.png"
  },
  "authority": {
    "providerExecution": false,
    "candidateApproval": false,
    "candidatePromotion": false,
    "targetRepositoryMutation": false,
    "gitMutation": false,
    "publication": false,
    "namedHumanApprovalRequired": true
  }
}

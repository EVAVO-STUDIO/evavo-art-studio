{
  "schema": "evavo.rally-forest-visual-development.v1",
  "protocolVersion": "2026-08-15.2",
  "assetId": "forest-stage-production-v1",
  "subjectId": "forest-stage",
  "title": "Forest Rally canonical playable stage",
  "style": {
    "projectionFamily": "fixed-isometric-2-5d",
    "designEra": "original-1990s-arcade-rally",
    "rendering": "high-definition-stylized-raster",
    "environmentLanguage": "A fast, readable temperate forest rally stage with rolling terrain, broad dirt and gravel roads, deliberate corner silhouettes, wet-weather variants and strong foreground-to-background value separation.",
    "palette": [
      "#101711",
      "#2f4a33",
      "#607554",
      "#84735a",
      "#b09a73",
      "#d6ccb8",
      "#53666d",
      "#272c2b"
    ],
    "surfaceLanguage": [
      "broad hand-painted terrain value groups",
      "readable road edges and shoulders",
      "restrained physically based response",
      "clear dry wet mud and water states",
      "limited repeated texture noise",
      "tree and rock silhouettes readable from the fixed camera"
    ],
    "forbidden": [
      "photogrammetry noise",
      "hyper-real forest clutter",
      "tiny unreadable signage",
      "modern motorway infrastructure",
      "baked directional shadows",
      "contact sheets",
      "multi-panel image layouts",
      "multiple unrelated locations in one image"
    ]
  },
  "cameraLocks": {
    "heroYawDegrees": 35,
    "heroPitchDegrees": 28,
    "topPlanPitchDegrees": 90,
    "focalLengthMm": 70,
    "consistentRoadWidth": true,
    "consistentTerrainScale": true,
    "consistentVegetationScale": true
  },
  "jobs": [

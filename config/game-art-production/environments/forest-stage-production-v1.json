      "id": "forest-stage-identity-dry",
      "role": "identity-master",
      "view": "isometric-wide",
      "phase": "identity",
      "width": 2048,
      "height": 2048,
      "transparent": false,
      "dependsOn": [],
      "include": ["single coherent dry forest rally stage", "rolling terrain", "dirt and gravel road", "readable corners", "tree-line depth"],
      "exclude": ["cars", "spectators", "rain", "night", "multiple locations"]
    },
    {
      "id": "forest-stage-identity-wet",

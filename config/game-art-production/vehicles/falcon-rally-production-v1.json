    "heroPitchDegrees": 24,
    "orthographicPitchDegrees": 0,
    "focalLengthMm": 70,
    "groundPlane": "neutral-matte",
    "consistentScale": true,
    "consistentWheelbase": true,
    "consistentTrackWidth": true

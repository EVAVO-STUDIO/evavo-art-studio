{
  "schema": "evavo.rally-falcon-visual-development.v1",
  "protocolVersion": "2026-08-15.1",
  "assetId": "falcon-rally-production-v1",
  "subjectId": "falcon-rally",
  "title": "Falcon Rally canonical player vehicle",
  "style": {
    "projectionFamily": "fixed-isometric-2.5d",
    "designEra": "original-1990s-arcade-rally",
    "rendering": "high-definition-stylized-raster",
    "silhouette": "Compact wide-track three-door rally hatch with a short front overhang, upright glasshouse, muscular wheel arches and an unmistakable planted stance readable at gameplay scale.",
    "bodyProportions": {
      "lengthToWidth": 2.18,
      "wheelbaseToLength": 0.61,
      "trackToWidth": 0.82,
      "wheelDiameterToHeight": 0.43
    },
    "palette": [
      "#111318",
      "#e44735",
      "#f2d6a2",
      "#f3efe5",
      "#6f7e78",
      "#262a30"
    ],
    "surfaceLanguage": [
      "broad hand-painted value groups",
      "restrained physically based response",
      "clean panel breaks",
      "readable rubber and glass separation",
      "limited fine decals",
      "damage masks that remain legible from the fixed camera"
    ],
    "forbidden": [
      "real manufacturer branding",
      "copyrighted race livery",
      "photogrammetry noise",
      "hyper-real clearcoat clutter",
      "tiny unreadable sponsor text",
      "baked directional shadows",
      "contact sheets",
      "multi-panel image layouts",
      "multiple cars in one image"
    ]
  },
  "cameraLocks": {

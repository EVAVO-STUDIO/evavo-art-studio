    "rendering": "high-definition-stylized-raster",
    "effectLanguage": "A readable damage-driven vehicle smoke family with a narrow source, soft rolling alpha, distinct clean, worn, damaged and critical densities, RPM cadence, crosswind breakup and no fire or generic opaque cloud.",
    "palette": [
      "#111315",
      "#22272b",
      "#363d42",
      "#505a60",
      "#727c80",
      "#969e9e",
      "#b9beb9",
      "#d6d8d1"
    ],
    "surfaceLanguage": [
      "narrow readable engine or exhaust origin",
      "dense core and softer outer breakup remain separate",
      "damage changes density and tint without changing the effect identity",
      "RPM changes cadence and travel rather than simply scaling the image",
      "wind bends soft wisps more than the dense core",
      "clean transparent alpha without rectangular edges"
    ],
    "forbidden": [
      "fire or flame",
      "explosion",
      "whole vehicle silhouette",
      "whole road scene",
      "solid black rectangle",
      "contact sheet",
      "multi-panel layout",
      "multiple unrelated plumes",
      "photographic stock compositing",
      "text or labels inside the image"
    ]
  },
  "continuity": {

      "soft directional wisps",
      "low translucent trailing haze",
      "cool white-grey smoke distinct from warm dirt dust",
      "clean alpha falloff without rectangular edges",
      "fixed-camera readability without hiding the vehicle silhouette"
    ],
    "forbidden": [
      "opaque smoke wall",
      "black engine smoke",
      "warm dirt dust",
      "fire or sparks",
      "vehicle silhouette baked into the image",
      "road background baked into the image",
      "hard rectangular alpha edge",
      "contact sheets",
      "multi-panel image layouts",
      "multiple unrelated effects in one image",
      "photographic tyre smoke",
      "text or branding"
    ]

{
  "schema": "evavo.rally-crash-debris-visual-development.v1",
  "protocolVersion": "2026-08-15.10",
  "assetId": "crash-debris-production-v1",
  "subjectId": "crash-debris",
  "title": "Rally vehicle crash debris",
  "style": {
    "projectionFamily": "fixed-isometric-2-5d",
    "designEra": "original-1990s-arcade-rally",
    "rendering": "high-definition-stylized-raster",
    "effectLanguage": "A readable one-shot vehicle impact family with paint chips, blunt metal shards, sparse body-panel fragments and restrained surface dust. Front, rear and side impacts share one visual identity while retaining distinct direction and silhouette.",
    "palette": ["#61191f", "#9a2932", "#c64b54", "#2c3033", "#62696c", "#a18a6d", "#c7b69a", "#e0d4bf"],
    "surfaceLanguage": [
      "impact origin remains visible",
      "small chips, medium shards and large panels remain distinct",
      "large fragments are sparse and blunt",
      "dust supports rather than hides the debris",
      "gravity and travel direction remain readable",
      "clean true transparency without rectangular edges"
    ],
    "forbidden": [
      "blood or gore",
      "glass fragments",
      "fire or explosion",
      "whole vehicle silhouette",
      "whole road scene",
      "knife-like fantasy shards",
      "screen-filling debris wall",
      "solid rectangular alpha",
      "contact sheet",
      "multi-panel layout",
      "multiple unrelated impacts",
      "text or labels"
    ]
  },
  "continuity": {
    "impactOriginReadable": true,
    "vehicleZonesDistinct": true,
    "fragmentFamiliesDistinct": true,
    "gravityReadable": true,
    "windResponseReadable": true,
    "roadBackgroundExcluded": true
  },

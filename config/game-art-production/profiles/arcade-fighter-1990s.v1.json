    {
      "id": "candidates-admitted",
      "rank": 3,
      "requiresEvidence": true,
      "requiresCandidate": true,
      "requiresHuman": false,
      "nextAction": "run-deterministic-qa"
    },
    {
      "id": "deterministic-qa-passed",
      "rank": 4,
      "requiresEvidence": true,
      "requiresCandidate": true,
      "requiresHuman": false,
      "nextAction": "run-creative-review"
    },
    {
      "id": "creative-review-passed",
      "rank": 5,
      "requiresEvidence": true,
      "requiresCandidate": true,
      "requiresHuman": false,
      "nextAction": "select-or-request-repair"
    },
    {
      "id": "selected-or-repair-requested",
      "rank": 6,
      "requiresEvidence": true,
      "requiresCandidate": true,
      "requiresHuman": true,
      "outcomes": [
        "selected",
        "repair-requested"
      ],
      "nextAction": "branch-on-human-decision"
    },
    {
      "id": "mastered",
      "rank": 7,
      "requiresEvidence": true,
      "requiresCandidate": true,
      "requiresHuman": false,
      "nextAction": "request-named-human-approval"
    },
    {
      "id": "named-human-approved",
      "rank": 8,
      "requiresEvidence": true,
      "requiresCandidate": true,
      "requiresHuman": true,
      "nextAction": "compile-delivery-readiness"
    },
    {
      "id": "delivery-ready",
      "rank": 9,
      "requiresEvidence": true,
      "requiresCandidate": true,
      "requiresHuman": false,
      "nextAction": "complete",
      "terminal": true
    }

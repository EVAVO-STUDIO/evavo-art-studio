    {
      "id": "planned",
      "rank": 0,
      "implicit": true,
      "requiresEvidence": false,
      "requiresCandidate": false,
      "requiresHuman": false,
      "nextAction": "lock-references"
    },
    {
      "id": "references-locked",
      "rank": 1,
      "requiresEvidence": true,
      "requiresCandidate": false,
      "requiresHuman": false,

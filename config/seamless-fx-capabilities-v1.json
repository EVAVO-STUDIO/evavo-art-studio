  "styles": ["realistic", "stylized", "cel-fx", "pixel", "engraved-dither", "hand-painted-game-vfx"],
  "families": [
    "smoke-cards", "fire-cards", "dust-cards", "rain-sprites", "snow-sprites", "hail-sprites", "lightning-frames",
    "explosion-frames", "spark-frames", "embers", "ash", "muzzle-flash-frames", "steam-cards", "fog-cards",
    "splash-frames", "raindrop-frames", "drip-frames", "foam-frames", "wave-overlays", "shore-breaker-overlays"

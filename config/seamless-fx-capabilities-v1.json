    "requiredQa": ["alpha-boundary-stability", "silhouette-continuity", "centroid-continuity", "palette-continuity", "frame-registration", "first-last-transition-review"]
  },
  "styles": ["realistic", "stylized", "cel-fx", "pixel", "engraved-dither", "hand-painted-game-vfx"],
  "families": [
    "smoke-cards", "fire-cards", "candle-flame-frames", "lantern-flame-frames", "light-flicker-overlays", "dust-cards", "rain-sprites", "snow-sprites", "hail-sprites", "lightning-frames",
    "explosion-frames", "spark-frames", "embers", "ash", "muzzle-flash-frames", "steam-cards", "fog-cards", "splash-frames", "rain-crown-frames", "raindrop-frames", "drip-frames", "foam-frames", "wave-overlays", "shore-breaker-overlays",
    "bullet-hole-decals", "bullet-graze-decals", "impact-mark-decals", "surface-chip-decals", "crack-decals", "scorch-decals", "soot-decals",
    "blood-splatter-decals", "blood-stains", "blood-smears", "blood-pools", "food-splatter-decals", "food-stains", "grease-stains", "drink-spills", "mud-splatters", "damp-stains", "water-stains", "rust-streaks", "runoff-streaks"
  ],
  "outputs": ["rgba-png-sequence", "sprite-sheet", "atlas", "individual-lossless-frames", "static-decal", "mask-sequence", "normal-sequence", "proof-sheet", "godot-spriteframes-source"],
  "quality": {
    "requiresTrueAlpha": true,
    "rejectPaintedCheckerboard": true,
    "requiresHaloCheck": true,
    "requiresFrameOrderAndDurationCheck": true,
    "requiresLoopTransitionCheck": true,
    "requiresSubstratePlausibilityForResidue": true,
    "requiresGravityConsistencyForSplatter": true,
    "candidateOnlyUntilApproved": true
  },
  "handoffs": {
    "particle-studio": "master procedural raster outputs, impacts, splatter bursts and sprite/atlas sources",
    "cel-animation-studio": "finish authored FX drawings without changing timing intent",
    "evavo-video-studio": "supply clean frame sequences and repaired alpha",
    "atmosphere-studio": "supply masks, cards, overlays, decals and protected-geometry art",
    "evavo-texture-studio": "exchange authored masks, palettes, stain/wetness sources and material-response images"
  }

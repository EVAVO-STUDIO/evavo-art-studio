{
  "schemaVersion": "1.0",
  "kind": "evavo.layered-production.godot-integration-request",
  "integrationId": "jonez-market-district-godot",
  "revision": "1.0.0",
  "assemblyId": "jonez-market-district-proof-assembly",
  "target": {

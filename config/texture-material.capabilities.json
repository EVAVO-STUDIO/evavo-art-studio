{
  "schemaVersion": "1.0",
  "id": "evavo-texture-material",
  "purpose": "Map-aware texture review, coherent material-set validation, seam proofs and guarded Godot ORM packing.",
  "entrypoint": "tools/texture_material_mcp.mjs",
  "protocol": "mcp-stdio-2025-03-26",
  "buildPrerequisite": "pnpm --filter @evavo/art-media build",
  "environment": {
    "EVAVO_TEXTURE_MATERIAL_ALLOWED_ROOTS": {
      "requiredForImageReadsAndWrites": true,
      "description": "Platform-delimited canonical roots the texture/material server may read and create derived outputs within."
    },
    "EVAVO_TEXTURE_MATERIAL_ALLOW_WRITES": {
      "requiredForWrites": true,
      "value": "true"
    }
  },
  "tools": [
    "evavo_texture_material_capabilities",
    "evavo_review_texture_map",
    "evavo_review_texture_set",
    "evavo_create_texture_tile_proof",
    "evavo_pack_godot_orm_texture"
  ],
  "mapKinds": [
    "base-color",
    "normal-tangent",
    "roughness",
    "metallic",
    "ambient-occlusion",
    "height",
    "emissive",
    "opacity",
    "specular",
    "orm-packed"
  ],
  "godot": {
    "normalConvention": "OpenGL X+ Y+ Z+",
    "ormChannelContract": "R=ambient-occlusion,G=roughness,B=metallic",
    "materials": ["StandardMaterial3D", "ORMMaterial3D"]
  },
  "guarantees": {
    "sourceMutationAllowed": false,
    "createOnlyOutputs": true,
    "explicitWriteConfirmation": true,
    "mapAwareReview": true,
    "matchingMaterialDimensionsByDefault": true,
    "strictScalarValidationByDefault": true,
    "bytesReturned": false
  }
}

{
  "schemaVersion": "1.1",
  "id": "evavo-image-finishing-packet",
  "purpose": "Unified read-only finishing decisions for single images and batches, combining technical review, artifact/generated-detail triage, repair routing, semantic findings and optional approved-reference consistency.",
  "entrypoint": "tools/image_finishing_packet_mcp.mjs",
  "protocol": "mcp-stdio-2025-03-26",
  "buildPrerequisite": "pnpm --filter @evavo/art-media build",
  "environment": {
    "EVAVO_IMAGE_FINISHING_PACKET_ALLOWED_ROOTS": {
      "requiredForImageReads": true,
      "description": "Platform-delimited canonical roots containing candidate and optional approved-reference images."
    }
  },
  "tools": [
    "evavo_image_finishing_packet_capabilities",
    "evavo_review_image_finishing_packet",
    "evavo_review_image_finishing_batch"
  ],
  "limits": {
    "approvedReferences": 32,
    "batchImages": 128
  },
  "batch": {
    "sharedApprovedReferenceModel": true,
    "compactAgentResponse": true,
    "perImageSemanticFindings": true,
    "priorityOrder": "priority, reference drift, technical quality"
  },
  "dispositions": [
    "ready-for-visual-review",
    "safe-local-repair",
    "localized-repair",
    "semantic-repair",
    "reacquire-or-regenerate",
    "human-review"
  ],
  "combines": [
    "technical-quality-review",
    "defect-regions-and-finishing-plan",
    "technical-artifact-signals",
    "generated-detail-risk",
    "repair-routing",
    "approved-reference-consistency",
    "explicit-semantic-visual-findings"
  ],
  "guarantees": {
    "sourceMutationAllowed": false,
    "writesFiles": false,
    "automaticPromotionAllowed": false,
    "humanVisualReviewRequired": true,
    "strongReferenceDriftCanDowngradeAutomaticRepair": true,
    "unstableReferenceSetRequiresHumanReview": true,
    "claimsAiOriginDetection": false
  }
}

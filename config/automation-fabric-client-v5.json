{
  "schemaVersion": 2,
  "kind": "evavo-automation-fabric-runtime-truth-client",
  "contractVersion": 5,
  "client": "evavo-art-studio",
  "role": "governed-art-production-media-validation-and-provider-control",
  "runtimeOwner": "EVAVO-STUDIO/evavo-local-storage",
  "minimumLocalStorageVersion": "0.42.1",
  "reviewedLocalStorageMain": "e68353d771632a604b66e5e30185823e8eadd312",
  "reviewedDevelopmentStudioMain": "a7aa347f2afc3371b0870d28f7be00df9ade7f3d",
  "poolId": "windows-local",
  "primaryNodeId": "windows-primary",
  "sourceContract": {
    "capabilitiesPath": "config/automation-fabric-capabilities.json",
    "physicalAcceptanceScript": "scripts/Test-EvavoAutomationFabricPhysical.ps1",
    "workstationAcceptanceCommand": "evavo-local-storage-workstation-accept",
    "workstationAcceptanceImplementation": "evavo_local_storage.workstation_acceptance_v4:main",
    "repositoryTaskPlanAction": "storage.repository_task_plan",
    "repositoryTaskExecuteAction": "storage.repository_task_run"
  },
  "runtimeEvidenceStates": [
    {"state":"declared","proof":"machine-readable source contract exists","permitsRoutineWorkerUse":false},
    {"state":"implemented","proof":"exact-source contract tests and native PowerShell parsing pass","permitsRoutineWorkerUse":false},
    {"state":"installed","proof":"expected current-user scheduled tasks and exact runtime revision are verified","permitsRoutineWorkerUse":false},
    {"state":"live","proof":"fresh identity-valid heartbeat from the expected runtime revision","permitsRoutineWorkerUse":false},
    {"state":"reachable","proof":"one fresh exact-node and one capability-routed pool command each return exactly one correlated receipt","permitsRoutineWorkerUse":true},
    {"state":"physically-accepted","proof":"bounded Windows acceptance proves execution, receipts, approved roots, archive round-trip and recoverable cleanup","permitsRoutineWorkerUse":true}
  ],
  "truthRules": {
    "sourceConfigurationIsRuntimeProof": false,
    "queuedWorkflowIsRuntimeProof": false,
    "taskRegistrationIsRuntimeProof": false,
    "heartbeatAloneIsReachabilityProof": false,
    "missingReceiptMeansSuccess": false,
    "staleReceiptMeansSuccess": false,
    "exactRequestToReceiptCorrelationRequired": true,
    "duplicateExecutionAllowed": false,
    "workerReceiptMustNameCommandId": true,
    "workerReceiptMustNameNodeId": true,
    "workerReceiptMustNameAction": true,
    "workerReceiptMustBeSuccessful": true,
    "repositoryTaskPlannerReceiptIsRuntimeMeasurement": true,
    "repositoryTaskPlannerReceiptIsPublicationEvidence": false,
    "unmeasuredRepositoryTaskMustPlanBeforeExecution": true,
    "physicalAcceptanceReceiptIsPublicationEvidence": false,
    "validationIsCreativeApproval": false,
    "validationIsRuntimePromotion": false
  },
  "routing": {
    "whenReachable": "plan unmeasured repository work read-only, bind execution to that exact planner receipt, then await the exact execution receipt",
    "whenReceiptMissingOrStale": "use Local Storage recovery and physical acceptance before routine Art Studio execution",
    "whenMailboxWorkerUnavailable": "do not enqueue additional repair commands through the unavailable mailbox",
    "askGregToPasteRoutineTerminalCommands": false,
    "manualTerminalRelayAllowedOnlyAfterAllRemoteRecoveryRoutesFail": true
  },
  "execution": {
    "preferredRoute": "windows-local",
    "fallbackExactNode": "windows-primary",
    "repositoryTaskPlanAction": "storage.repository_task_plan",
    "repositoryTaskExecuteAction": "storage.repository_task_run",
    "plannerReceiptRequiredForUnmeasuredRepositoryTask": true,
    "plannerMeasuresExactHead": true,
    "plannerMeasuresExactStatusSha256": true,
    "plannerMeasuresTrackedScriptSha256": true,
    "trackedScriptBytesRequired": true,
    "credentialStrippingRequired": true,
    "fileFirstPowerShell": true,
    "powershellGuardRequired": true,
    "explicitNativeExitCodeRequired": true,
    "argvOnlyProcessesPreferred": true,
    "resourceAwareAdmissionRequired": true,
    "boundedProcessTreeTerminationRequired": true,
    "automaticTransientRetryOnly": true,
    "maximumAttempts": 3,
    "approvedRoots": ["C:\\GitRepos","C:\\Downloads","C:\\BEESTATION","approved-discovered-external-roots"],
    "routineCapabilities": ["filesystem","powershell","cmd","bash","python","node","npm","pnpm","curl","git","github-cli","archive","beestation","external-storage","art-pipeline-validation","image-toolchain","provider-runtime"]
  },
  "githubActionsFallback": {
    "developmentStudioContract": "evavo-github-actions-worker-fallback",
    "eligibleStatus": "provider-allocation-blocked",
    "zeroStepsRequired": true,
    "completedFailedRunRequired": true,
    "exactBlockedRevisionRequired": true,
    "plannerReceiptBoundToBlockedRevision": true,
    "readOnlyValidationOnly": true,
    "githubActionsEquivalent": false,
    "githubCheckStatusMutation": false,
    "workerReceiptIsPublicationEvidence": false
  },
  "workerAuthority": {
    "repositoryCommitAllowed": false,
    "repositoryPushAllowed": false,
    "mainlinePublicationAllowed": false,
    "providerPromotionAllowed": false,
    "creativeApprovalAllowed": false,
    "runtimeActivationAllowed": false
  },
  "publication": {
    "operatorRepository": "EVAVO-STUDIO/evavo-development-studio",
    "operator": "scripts/mainline-publish.mjs",
    "guardedMainPublicationRequired": true,
    "exactRemoteHeadRecheckRequired": true,
    "declaredPathsOnly": true,
    "remoteShaVerificationRequired": true,
    "forcePush": false,
    "automaticMerge": false,
    "automaticRebase": false
  },
  "safety": {
    "resetHard": false,
    "gitClean": false,
    "stashAsRecovery": false,
    "permanentDelete": false,
    "providerDeleteImpliedByWorkerAuthority": false,
    "downloadAloneAuthorizesExecution": false,
    "secretEnvironmentCallerOverride": false,
    "cleanupDestination": "bee://primary/TO_DELETE/"
  }
}

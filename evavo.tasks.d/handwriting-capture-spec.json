{
  "schemaVersion": 1,
  "kind": "evavo-repository-task-manifest-fragment",
  "repository": "evavo-art-studio",
  "tasks": {
    "handwriting-capture-spec": {
      "runtime": "python-script",
      "pythonEnvironment": "image-finishing",
      "entry": "tools/handwriting_capture_spec.py",
      "arguments": ["{{output}}", "--profile-id", "{{profileId}}"],
      "parameterSchema": {
        "schemaVersion": 1,
        "additionalProperties": false,
        "required": ["output", "profileId"],
        "properties": {
          "output": {"type": "compute-path", "pathKind": "file", "access": "output"},
          "profileId": {"type": "string", "minimumLength": 1, "maximumLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}
        }
      },
      "parameterOutputs": ["output"],
      "network": "disabled",
      "timeoutSeconds": 120,
      "description": "Create a deterministic worksheet specification for collecting genuine missing handwriting variants such as lowercase letters, digits, punctuation, common fragments, names and signatures. Creates no handwriting itself and grants no document approval authority."
    }
  }
}

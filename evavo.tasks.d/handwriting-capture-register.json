{
  "schemaVersion": 1,
  "kind": "evavo-repository-task-manifest-fragment",
  "repository": "evavo-art-studio",
  "tasks": {
    "handwriting-capture-register": {
      "runtime": "python-script",
      "pythonEnvironment": "image-finishing",
      "entry": "tools/handwriting_capture_register.py",
      "arguments": ["{{sheetManifest}}", "{{registration}}", "{{sourceImage}}", "{{layout}}", "--page", "{{page}}"],
      "parameterSchema": {
        "schemaVersion": 1,
        "additionalProperties": false,
        "required": ["sheetManifest", "registration", "sourceImage", "layout", "page"],
        "properties": {
          "sheetManifest": {"type": "compute-path", "pathKind": "file", "access": "input"},
          "registration": {"type": "compute-path", "pathKind": "file", "access": "input"},
          "sourceImage": {"type": "compute-path", "pathKind": "file", "access": "input"},
          "layout": {"type": "compute-path", "pathKind": "file", "access": "output"},
          "page": {"type": "integer", "minimum": 1, "maximum": 128}
        }
      },
      "parameterOutputs": ["layout"],
      "network": "disabled",
      "timeoutSeconds": 180,
      "description": "Map a photographed generated handwriting worksheet back to its known slot geometry using reviewed four-corner page registration and create a SHA-bound Document Studio sheet-layout file. Returns no handwriting bytes and grants no document approval authority."
    }
  }
}

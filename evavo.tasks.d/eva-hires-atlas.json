{
  "schemaVersion": 1,
  "kind": "evavo-repository-task-manifest-fragment",
  "repository": "evavo-art-studio",
  "tasks": {
    "eva-reviewed-hires-atlas-clean-master": {
      "runtime": "python-script",
      "pythonEnvironment": "image-finishing",
      "entry": "tools/eva_hires_atlas_clean_master.py",
      "arguments": [
        "--workspace-root",
        "{{workspaceRoot}}",
        "--plan",
        "{{plan}}",
        "--plan-sha256",
        "{{planSha256}}",
        "--output-root",
        "{{outputRoot}}"
      ],
      "parameterSchema": {
        "schemaVersion": 1,
        "additionalProperties": false,
        "required": ["workspaceRoot", "plan", "planSha256", "outputRoot"],
        "properties": {
          "workspaceRoot": {
            "type": "compute-path",
            "pathKind": "directory",
            "access": "input"
          },
          "plan": {
            "type": "compute-path",
            "pathKind": "file",
            "access": "input"
          },
          "planSha256": {
            "type": "string",
            "minimumLength": 64,
            "maximumLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          },
          "outputRoot": {
            "type": "compute-path",
            "pathKind": "directory",
            "access": "output"
          }
        }
      },
      "parameterOutputs": ["outputRoot"],
      "network": "disabled",
      "timeoutSeconds": 3600,
      "description": "Build one exact SHA-bound fixed-grid EVA RGBA PNG atlas clean master from 36 reviewed tier frames without trimming, rotation, reordering, resizing or shelf packing. Reopen the encoded PNG and require exact RGBA parity for every frame rectangle. The output is create-only and grants no creative approval, WebP delivery approval, Cloudinary upload, runtime/website activation, publication or repository authority."
    }
  }
}

{
  "schemaVersion": 1,
  "kind": "evavo-repository-task-manifest-fragment",
  "repository": "evavo-art-studio",
  "tasks": {
    "handwriting-multiline-render": {
      "runtime": "python-script",
      "pythonEnvironment": "image-finishing",
      "entry": "tools/handwriting_multiline.py",
      "arguments": ["{{atlas}}", "{{text}}", "{{output}}", "--seed", "{{seed}}", "--style", "{{style}}", "--line-spacing-factor", "{{lineSpacingFactor}}", "--proof", "{{proof}}", "--receipt", "{{receipt}}"],
      "parameterSchema": {
        "schemaVersion": 1,
        "additionalProperties": false,
        "required": ["atlas", "text", "output", "seed", "proof", "receipt"],
        "properties": {
          "atlas": {"type": "compute-path", "pathKind": "file", "access": "input"},
          "text": {"type": "string", "minimumLength": 1, "maximumLength": 8192},
          "output": {"type": "compute-path", "pathKind": "file", "access": "output"},
          "seed": {"type": "string", "minimumLength": 1, "maximumLength": 256, "pattern": "^[A-Za-z0-9._:/-]+$"},
          "style": {"type": "string", "minimumLength": 0, "maximumLength": 64, "pattern": "^[A-Za-z0-9._-]*$", "default": ""},
          "lineSpacingFactor": {"type": "number", "minimum": 0.2, "maximum": 2.0, "default": 0.55},
          "proof": {"type": "compute-path", "pathKind": "file", "access": "output"},
          "receipt": {"type": "compute-path", "pathKind": "file", "access": "output"}
        }
      },
      "parameterOutputs": ["output", "proof", "receipt"],
      "network": "disabled",
      "timeoutSeconds": 300,
      "description": "Render create-only multi-line handwriting by composing independently rendered genuine atlas lines with deterministic per-line seeds and bounded line spacing. Blank lines remain blank; unsupported characters fail closed; no font fallback, synthetic handwriting or signature synthesis."
    }
  }
}

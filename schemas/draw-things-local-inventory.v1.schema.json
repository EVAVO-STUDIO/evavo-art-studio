{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evavo.studio/schemas/draw-things-local-inventory.v1.schema.json",
  "title": "EVAVO Draw Things Local Inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "capturedAt",
    "bridgeEndpoint",
    "grpcEndpoint",
    "installManifestSha256",
    "models",
    "rawCategoryCounts"
  ],
  "properties": {
    "schema": { "const": "evavo.draw-things-local-inventory.v1" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "bridgeEndpoint": { "type": "string", "format": "uri" },
    "grpcEndpoint": { "type": "string", "minLength": 1, "maxLength": 512 },
    "installManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "models": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "file",
          "version",
          "bundleSha256",
          "metadataSha256",
          "components",
          "model"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 512 },
          "file": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "version": { "type": "string", "minLength": 1, "maxLength": 256 },
          "bundleSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "metadataSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "components": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["relativePath", "sizeBytes", "sha256"],
              "properties": {
                "relativePath": { "type": "string", "minLength": 1, "maxLength": 2048 },
                "sizeBytes": { "type": "integer", "minimum": 1 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              }
            }
          },
          "model": { "type": "object" }
        }
      }
    },
    "rawCategoryCounts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evavo.com/schemas/evavo.agent-workbench-snapshot.schema.json",
  "title": "EVAVO Agent Workbench Snapshot v1",
  "type": "object",
  "required": ["contract", "generatedAt", "repository", "authority", "role", "objective", "mode", "sourceEvidence", "inventory", "discovery", "orientation", "matches", "automation", "policy"],
  "properties": {
    "contract": {"const": "evavo_agent_workbench_snapshot_v1"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "authority": {"type": "string", "minLength": 1},
    "role": {"type": "string"},
    "objective": {"type": "string"},
    "mode": {"enum": ["complete-local-inventory", "broad-orientation", "objective-ranked-orientation"]},
    "sourceEvidence": {"type": "object", "required": ["workbenchConfig", "capabilityManifest", "packageManifest"], "additionalProperties": {"$ref": "#/$defs/fileEvidence"}},
    "inventory": {"type": "object", "required": ["capabilityCount", "packageScriptCount", "toolCount", "registeredToolCount", "mcpServerCount", "estateCapabilityCount", "estateGatewayRepositoryCount", "estateGatewayResolvedRepositoryCount", "estateGatewayServerCount", "estateGatewayDeclaredServerCount", "estate", "estateGateway"], "properties": {"capabilityCount": {"type": "integer", "minimum": 0}, "packageScriptCount": {"type": "integer", "minimum": 0}, "toolCount": {"type": "integer", "minimum": 0}, "registeredToolCount": {"type": "integer", "minimum": 0}, "mcpServerCount": {"type": "integer", "minimum": 0}, "estateCapabilityCount": {"type": "integer", "minimum": 0}, "estateGatewayRepositoryCount": {"type": "integer", "minimum": 0}, "estateGatewayResolvedRepositoryCount": {"type": "integer", "minimum": 0}, "estateGatewayServerCount": {"type": "integer", "minimum": 0}, "estateGatewayDeclaredServerCount": {"type": "integer", "minimum": 0}, "estate": {"type": ["object", "null"]}, "estateGateway": {"type": ["object", "null"]}}},
    "discovery": {"type": "object", "required": ["toolRegistryOrigin", "siblingDevelopmentStudioRegistryAutoDiscovered", "mcpLaunchManifestObserved", "mcpLaunchManifestSanitized", "estateSnapshotOrigin", "developmentEstateAuditAutoDiscovered", "estateEvidenceComplete", "estateGatewayInventoryObserved", "estateGatewayInventorySanitized"], "properties": {"toolRegistryOrigin": {"enum": ["explicit", "repository-config", "sibling-development-studio", "unavailable"]}, "siblingDevelopmentStudioRegistryAutoDiscovered": {"type": "boolean"}, "mcpLaunchManifestObserved": {"type": "boolean"}, "mcpLaunchManifestSanitized": {"type": "boolean"}, "estateSnapshotOrigin": {"enum": ["explicit", "development-studio-latest-estate-audit", "unavailable"]}, "developmentEstateAuditAutoDiscovered": {"type": "boolean"}, "estateEvidenceComplete": {"type": "boolean"}, "estateGatewayInventoryObserved": {"type": "boolean"}, "estateGatewayInventorySanitized": {"type": "boolean"}}},
    "orientation": {"type": "object", "required": ["readFirst", "phases", "handoffs"], "properties": {"readFirst": {"type": "array"}, "phases": {"type": "array", "minItems": 1}, "handoffs": {"type": "array"}}},
    "matches": {"type": "object", "required": ["capabilities", "scripts", "tools", "estateCapabilities"], "properties": {"capabilities": {"type": "array"}, "scripts": {"type": "array"}, "tools": {"type": "array"}, "estateCapabilities": {"type": "array"}}},
    "automation": {"type": "object", "required": ["safeWithoutApproval", "gated", "neverImplied"]},
    "policy": {"type": "object", "required": ["readOnlyCompiler", "commandExecutionPerformed", "mutationPerformed", "sourceCapabilityDoesNotImplyRuntimeReadiness", "routeDoesNotAuthorizeEffects", "planDoesNotProveExecution", "incompleteEstateCannotProveAbsence", "publicationRequiresSeparateAuthority", "mcpRegistrationDoesNotImplyRuntimeReadiness", "mcpEnvironmentValuesRetained", "mcpArgumentValuesRetained", "estateAutoDiscoveryRunsProviderQueries", "estateGatewayRegistrationDoesNotImplyRuntimeReadiness", "estateGatewayRawDefinitionsRetained", "estateGatewayRawGitRemoteUrlsRetained", "estateGatewayAutoDiscoveryRunsProviderQueries"], "properties": {"readOnlyCompiler": {"const": true}, "commandExecutionPerformed": {"const": false}, "mutationPerformed": {"const": false}, "sourceCapabilityDoesNotImplyRuntimeReadiness": {"const": true}, "routeDoesNotAuthorizeEffects": {"const": true}, "planDoesNotProveExecution": {"const": true}, "incompleteEstateCannotProveAbsence": {"type": "boolean"}, "publicationRequiresSeparateAuthority": {"const": true}, "mcpRegistrationDoesNotImplyRuntimeReadiness": {"const": true}, "mcpEnvironmentValuesRetained": {"const": false}, "mcpArgumentValuesRetained": {"const": false}, "estateAutoDiscoveryRunsProviderQueries": {"const": false}, "estateGatewayRegistrationDoesNotImplyRuntimeReadiness": {"const": true}, "estateGatewayRawDefinitionsRetained": {"const": false}, "estateGatewayRawGitRemoteUrlsRetained": {"const": false}, "estateGatewayAutoDiscoveryRunsProviderQueries": {"const": false}}}
  },
  "$defs": {"fileEvidence": {"type": "object", "required": ["path", "sha256", "bytes"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 0}, "sanitized": {"type": "boolean"}, "rawEnvironmentValuesRetained": {"type": "boolean"}, "rawArgumentValuesRetained": {"type": "boolean"}}}}
}

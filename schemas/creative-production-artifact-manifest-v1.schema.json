{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://evavo.com.au/contracts/creative-production-artifact-manifest-v1.schema.json",
  "title":"EVAVO Creative Production Artifact Manifest v1.1",
  "type":"object","additionalProperties":false,
  "required":["kind","schemaVersion","status","packetId","sourceDigest","studio","repository","operation","artifactRevision","deliveryRoot","files","authority","limitations","manifestDigest"],
  "properties":{
    "kind":{"const":"creative-production-artifact-manifest"},"schemaVersion":{"const":"1.1.0"},"status":{"const":"revision-files-bound"},
    "packetId":{"type":"string","minLength":1},"sourceDigest":{"type":"string","minLength":1},"studio":{"const":"art-studio"},"repository":{"const":"EVAVO-STUDIO/evavo-art-studio"},"operation":{"enum":["produce-environment-art","produce-game-art","produce-environment-key-art","produce-game-concept-art","produce-game-ui"]},
    "artifactRevision":{"type":"object","required":["id","digest"],"properties":{"id":{"type":"string","minLength":1},"digest":{"type":"string","minLength":1}},"additionalProperties":true},
    "deliveryRoot":{"type":"string","pattern":"^artifacts/art-studio/[0-9a-f]{24}$"},
    "files":{"type":"array","minItems":1,"maxItems":1000,"items":{"type":"object","additionalProperties":false,"required":["path","role","mediaType","digest","byteLength","canonicalRuntimeAsset","reviewOnly"],"properties":{"path":{"type":"string","minLength":1},"role":{"type":"string","minLength":1},"mediaType":{"type":"string","pattern":"^[^/\\s]+/[^/\\s]+$"},"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"byteLength":{"type":"integer","minimum":0},"canonicalRuntimeAsset":{"type":"boolean"},"reviewOnly":{"type":"boolean"}}}},
    "authority":{"type":"object","additionalProperties":false,"required":["importsIntoConsumer","executesProduction","mutatesConsumerRepository","publishes"],"properties":{"importsIntoConsumer":{"const":false},"executesProduction":{"const":false},"mutatesConsumerRepository":{"const":false},"publishes":{"const":false}}},
    "limitations":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"manifestDigest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evavo.local/schemas/mobile-app-asset-plan.v1.json",
  "title": "EVAVO mobile app asset plan v1",
  "type": "object",
  "required": [
    "schema",
    "requestId",
    "source",
    "app",
    "runtimeRepository",
    "platforms",
    "tasks",
    "review",
    "storage",
    "prohibitedOperations",
    "authority",
    "planSha256"
  ],
  "properties": {
    "schema": { "const": "evavo.mobile-app-asset-plan.v1" },
    "requestId": { "type": "string" },
    "runtimeRepository": { "type": "string", "pattern": "^EVAVO-STUDIO/[A-Za-z0-9._-]+$" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["id", "assetId", "kind", "purpose", "platforms", "workspace", "context", "production", "runtimeHandoff"]
      }
    },
    "authority": {
      "type": "object",
      "properties": {
        "mayApproveAssets": { "const": false },
        "mayWriteRuntimeTargets": { "const": false },
        "mayCommitOrPushRuntimeRepository": { "const": false },
        "mayTreatGenerationAsApproval": { "const": false }
      }
    },
    "planSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}

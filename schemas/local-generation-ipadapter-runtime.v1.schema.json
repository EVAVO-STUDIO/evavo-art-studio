{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evavo.studio/schemas/local-generation-ipadapter-runtime.v1.schema.json",
  "title": "EVAVO Local Generation IP-Adapter Runtime v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runtimeId", "version", "customNodeFolder", "runtimeSha256", "ipAdapterModel", "clipVisionModel", "roles"],
  "properties": {
    "schema": { "const": "evavo.local-generation-ipadapter-runtime.v1" },
    "runtimeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "customNodeFolder": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "runtimeSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ipAdapterModel": { "$ref": "#/$defs/model" },
    "clipVisionModel": { "$ref": "#/$defs/model" },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "enum": ["canonical-identity", "direction-master", "palette-reference", "material-reference", "layer-context"] }
    },
    "weight": { "type": "number", "minimum": -1, "maximum": 5 },
    "weightType": { "type": "string", "minLength": 1, "maxLength": 128 },
    "combineEmbeds": { "enum": ["concat", "add", "subtract", "average", "norm average"] },
    "startAt": { "type": "number", "minimum": 0, "maximum": 1 },
    "endAt": { "type": "number", "minimum": 0, "maximum": 1 },
    "embedsScaling": { "type": "string", "minLength": 1, "maxLength": 128 },
    "baseModelNodeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "samplerNodeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fileName", "sha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evavo.studio/schemas/draw-things-approved-model-policy.v1.schema.json",
  "title": "EVAVO Draw Things Approved Model Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policyId",
    "reviewedBy",
    "reviewedAt",
    "models"
  ],
  "properties": {
    "schema": {
      "const": "evavo.draw-things-approved-model-policy.v1"
    },
    "policyId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "inventoryName",
          "inventoryFile",
          "version",
          "expectedFiles",
          "source",
          "license",
          "approvedUses",
          "generationDefaults",
          "priority"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "inventoryName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "inventoryFile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "expectedFiles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "sha256"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "publisher",
              "url"
            ],
            "properties": {
              "publisher": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "url": {
                "type": "string",
                "format": "uri",
                "maxLength": 2048
              }
            }
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "url",
              "commercialUse",
              "derivatives",
              "redistribution"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "url": {
                "type": "string",
                "format": "uri",
                "maxLength": 2048
              },
              "commercialUse": {
                "enum": [
                  "allowed",
                  "restricted",
                  "unknown",
                  "prohibited"
                ]
              },
              "derivatives": {
                "enum": [
                  "allowed",
                  "restricted",
                  "unknown",
                  "prohibited"
                ]
              },
              "redistribution": {
                "enum": [
                  "allowed",
                  "restricted",
                  "unknown",
                  "prohibited"
                ]
              }
            }
          },
          "approvedUses": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "enum": [
                "concept",
                "illustration",
                "sprite",
                "environment",
                "effect",
                "ui",
                "print",
                "reference",
                "lora-training"
              ]
            }
          },
          "generationDefaults": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "steps",
              "cfg",
              "samplerName",
              "seedMode",
              "clipSkip",
              "shift",
              "resolutionDependentShift",
              "speedUp",
              "teaCache",
              "teaCacheThreshold",
              "teaCacheStart",
              "teaCacheEnd",
              "teaCacheMaxSkipSteps"
            ],
            "properties": {
              "steps": {
                "type": "integer",
                "minimum": 1,
                "maximum": 150
              },
              "cfg": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "samplerName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "seedMode": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "clipSkip": {
                "type": "integer",
                "minimum": 1,
                "maximum": 23
              },
              "shift": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 16
              },
              "resolutionDependentShift": {
                "type": "boolean"
              },
              "speedUp": {
                "type": "boolean"
              },
              "teaCache": {
                "type": "boolean"
              },
              "teaCacheThreshold": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "teaCacheStart": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "teaCacheEnd": {
                "type": "integer",
                "minimum": -151,
                "maximum": 150
              },
              "teaCacheMaxSkipSteps": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50
              }
            }
          },
          "priority": {
            "type": "integer",
            "minimum": -1000,
            "maximum": 1000
          },
          "resourceClass": {
            "enum": [
              "baseline",
              "quality",
              "heavy"
            ]
          },
          "notes": {
            "type": "string",
            "maxLength": 4096
          }
        }
      }
    },
    "reviewedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}

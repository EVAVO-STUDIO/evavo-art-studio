{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evavo.studio/schemas/draw-things-model-governance.v1.schema.json",
  "title": "EVAVO Draw Things Model Governance v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "models"],
  "properties": {
    "schema": { "const": "evavo.draw-things-model-governance.v1" },
    "models": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "inventoryName",
          "inventoryFile",
          "version",
          "bundleSha256",
          "source",
          "license",
          "approvedUses",
          "reviewedBy",
          "reviewedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "inventoryName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "inventoryFile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "bundleSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["publisher", "url"],
            "properties": {
              "publisher": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "url": {
                "type": "string",
                "format": "uri",
                "maxLength": 2048
              }
            }
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "url",
              "commercialUse",
              "derivatives",
              "redistribution"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "url": {
                "type": "string",
                "format": "uri",
                "maxLength": 2048
              },
              "commercialUse": {
                "enum": ["allowed", "restricted", "unknown", "prohibited"]
              },
              "derivatives": {
                "enum": ["allowed", "restricted", "unknown", "prohibited"]
              },
              "redistribution": {
                "enum": ["allowed", "restricted", "unknown", "prohibited"]
              }
            }
          },
          "approvedUses": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "enum": [
                "concept",
                "illustration",
                "sprite",
                "environment",
                "effect",
                "ui",
                "print",
                "reference",
                "lora-training"
              ]
            }
          },
          "reviewedBy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "reviewedAt": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string",
            "maxLength": 4096
          }
        }
      }
    }
  }
}

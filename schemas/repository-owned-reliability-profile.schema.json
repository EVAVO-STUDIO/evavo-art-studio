{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.evavo.dev/art-studio/repository-owned-reliability-profile.schema.json",
  "title": "EVAVO Art Studio repository-owned reliability profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "repository",
    "defaultBranch",
    "authority",
    "stack",
    "packageManager",
    "dependencyLock",
    "runtime",
    "imageToolchain",
    "pixelFontStudio",
    "workspace",
    "validation",
    "executedBaseline",
    "capabilityBoundary",
    "notes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.2"
    },
    "id": {
      "const": "evavo-art-studio"
    },
    "repository": {
      "const": "EVAVO-STUDIO/evavo-art-studio"
    },
    "defaultBranch": {
      "const": "main"
    },
    "authority": {
      "const": "canonical-art-production-studio"
    },
    "stack": {
      "const": "node-pnpm-creative-workspace"
    },
    "packageManager": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "exactVersion",
        "lockfilePath",
        "lockfilePolicy",
        "lockfilePresent",
        "install"
      ],
      "properties": {
        "name": {
          "const": "pnpm"
        },
        "exactVersion": {
          "const": "10.13.1"
        },
        "lockfilePath": {
          "const": "pnpm-lock.yaml"
        },
        "lockfilePolicy": {
          "const": "committed-frozen"
        },
        "lockfilePresent": {
          "const": true
        },
        "install": {
          "const": "pnpm install --frozen-lockfile"
        }
      }
    },
    "dependencyLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "format",
        "generatedWith",
        "committed",
        "frozenInstallationRequired",
        "immutableDuringValidation"
      ],
      "properties": {
        "path": {
          "const": "pnpm-lock.yaml"
        },
        "format": {
          "const": "pnpm-lockfile-v9"
        },
        "generatedWith": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node",
            "pnpm"
          ],
          "properties": {
            "node": {
              "const": "22.14.0"
            },
            "pnpm": {
              "const": "10.13.1"
            }
          }
        },
        "committed": {
          "const": true
        },
        "frozenInstallationRequired": {
          "const": true
        },
        "immutableDuringValidation": {
          "const": true
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "pnpm",
        "next",
        "react",
        "typescript"
      ],
      "properties": {
        "node": {
          "const": "22.14.0"
        },
        "pnpm": {
          "const": "10.13.1"
        },
        "next": {
          "const": "^16.2.12"
        },
        "react": {
          "const": "^19.2.8"
        },
        "typescript": {
          "const": "^5.9.2"
        }
      }
    },
    "imageToolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "requirements",
        "pillow",
        "install",
        "verification"
      ],
      "properties": {
        "python": {
          "const": "3.13.5"
        },
        "requirements": {
          "const": "requirements-image-pipeline.txt"
        },
        "pillow": {
          "const": "12.2.0"
        },
        "install": {
          "const": "python -m pip install --disable-pip-version-check -r requirements-image-pipeline.txt"
        },
        "verification": {
          "const": "python tools/verify_brass_creative_evaluation.py"
        }
      }
    },
    "pixelFontStudio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "requestSchema",
        "familySchema",
        "validationSchema",
        "runtimeFormat",
        "sourceGrid",
        "externalFontBinaryUsed",
        "deterministic",
        "createOnly",
        "mcpDefaultMode",
        "writeEnvironmentGateRequired",
        "writePerCallConfirmationRequired",
        "allowedRootBoundaryRequired",
        "godotPolicy",
        "authority",
        "deliveryProfiles"
      ],
      "properties": {
        "contract": {
          "const": "evavo.pixel-font-studio.v1"
        },
        "requestSchema": {
          "const": "evavo.pixel-font-family-request.v1"
        },
        "familySchema": {
          "const": "evavo.pixel-font-family.v1"
        },
        "validationSchema": {
          "const": "evavo.pixel-font-validation.v1"
        },
        "runtimeFormat": {
          "const": "AngelCode BMFont text plus RGBA PNG atlas"
        },
        "sourceGrid": {
          "const": "evavo-5x7-v1"
        },
        "externalFontBinaryUsed": {
          "const": false
        },
        "deterministic": {
          "const": true
        },
        "createOnly": {
          "const": true
        },
        "mcpDefaultMode": {
          "const": "read-only"
        },
        "writeEnvironmentGateRequired": {
          "const": true
        },
        "writePerCallConfirmationRequired": {
          "const": true
        },
        "allowedRootBoundaryRequired": {
          "const": true
        },
        "godotPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimumVersion",
            "targetVersion",
            "textureFilter",
            "integerScaleOnly",
            "subpixelPositioning",
            "mipmaps"
          ],
          "properties": {
            "minimumVersion": {
              "const": "4.0"
            },
            "targetVersion": {
              "const": "4.6.2"
            },
            "textureFilter": {
              "const": "nearest"
            },
            "integerScaleOnly": {
              "const": true
            },
            "subpixelPositioning": {
              "const": false
            },
            "mipmaps": {
              "const": false
            }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "providerExecution",
            "creativeApproval",
            "historicalApproval",
            "nativeGodotApproval",
            "candidatePromotion",
            "sourceMutation",
            "sourceDeletion",
            "targetRepositoryMutation",
            "gitCommit",
            "gitPush",
            "publication",
            "forcePush"
          ],
          "properties": {
            "providerExecution": {
              "const": false
            },
            "creativeApproval": {
              "const": false
            },
            "historicalApproval": {
              "const": false
            },
            "nativeGodotApproval": {
              "const": false
            },
            "candidatePromotion": {
              "const": false
            },
            "sourceMutation": {
              "const": false
            },
            "sourceDeletion": {
              "const": false
            },
            "targetRepositoryMutation": {
              "const": false
            },
            "gitCommit": {
              "const": false
            },
            "gitPush": {
              "const": false
            },
            "publication": {
              "const": false
            },
            "forcePush": {
              "const": false
            }
          }
        },
        "deliveryProfiles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "review",
            "runtime"
          ],
          "properties": {
            "review": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "includeSpecimens",
                "includeDetailedGlyphRecords"
              ],
              "properties": {
                "includeSpecimens": {
                  "const": true
                },
                "includeDetailedGlyphRecords": {
                  "const": true
                }
              }
            },
            "runtime": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "includeSpecimens",
                "includeDetailedGlyphRecords"
              ],
              "properties": {
                "includeSpecimens": {
                  "const": false
                },
                "includeDetailedGlyphRecords": {
                  "const": false
                }
              }
            }
          }
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "packages"
      ],
      "properties": {
        "manifest": {
          "const": "pnpm-workspace.yaml"
        },
        "packages": {
          "const": [
            "apps/*",
            "packages/*"
          ]
        }
      }
    },
    "validation": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "executedBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "runId",
        "headSha",
        "conclusion",
        "installedWithoutCommittedLockfile"
      ],
      "properties": {
        "workflow": {
          "const": ".github/workflows/ci.yml"
        },
        "runId": {
          "const": "30544861146"
        },
        "headSha": {
          "pattern": "^[a-f0-9]{40}$"
        },
        "conclusion": {
          "const": "success"
        },
        "installedWithoutCommittedLockfile": {
          "const": true
        }
      }
    },
    "capabilityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validationMay",
        "validationDoesNotAuthorize"
      ],
      "properties": {
        "validationMay": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validationDoesNotAuthorize": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

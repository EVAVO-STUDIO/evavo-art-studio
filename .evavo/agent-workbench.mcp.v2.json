{
  "contractVersion": "evavo_agent_workbench_mcp_v2",
  "repository": "EVAVO-STUDIO/evavo-art-studio",
  "authority": "art-studio",
  "transport": "stdio",
  "protocolVersion": "2025-03-26",
  "supportedProtocolVersions": ["2025-03-26", "2026-07-28"],
  "evavoDiscoveryMethod": "server/discover",
  "command": "node",
  "args": ["scripts/agent-workbench-mcp-v2.mjs"],
  "readOnly": true,
  "tools": [
    "evavo_agent_workbench_capabilities",
    "evavo_agent_workbench_snapshot",
    "evavo_agent_workbench_fleet",
    "evavo_agent_workbench_guide",
    "evavo_agent_workbench_handoff"
  ],
  "fleet": {
    "schema": "schemas/evavo.agent-workbench-fleet.schema.json",
    "compiler": "scripts/agent-workbench-fleet.mjs",
    "verifier": "scripts/verify-agent-workbench-fleet.mjs",
    "scope": "local-workbench-enabled-siblings"
  },
  "guidance": {
    "schema": "schemas/evavo.agent-workbench-guidance.schema.json",
    "compiler": "scripts/agent-workbench-guide.mjs",
    "verifier": "scripts/verify-agent-workbench-guidance.mjs"
  },
  "registration": {
    "serverName": "evavo-agent-workbench-v2",
    "check": "node scripts/agent-workbench-mcp-registration.mjs --check",
    "write": "node scripts/agent-workbench-mcp-registration.mjs --write",
    "test": "node scripts/test-agent-workbench-mcp-registration.mjs"
  },
  "doctor": {
    "check": "node scripts/agent-workbench-doctor.mjs",
    "repairRegistration": "node scripts/agent-workbench-doctor.mjs --repair-registration",
    "test": "node scripts/test-agent-workbench-doctor.mjs"
  },
  "evidenceRootsEnvironment": "EVAVO_AGENT_WORKBENCH_EVIDENCE_ROOTS",
  "smokeTest": "node scripts/test-agent-workbench-mcp-v2.mjs",
  "truthBoundary": {
    "executesCandidateCommands": false,
    "mutatesRepository": false,
    "mutatesProviders": false,
    "grantsExecutionAuthority": false,
    "grantsMutationAuthority": false,
    "grantsPublicationAuthority": false,
    "guidanceProvesReadiness": false,
    "fleetAuthorizesExecution": false,
    "fleetClaimsProviderCompleteness": false,
    "fleetAllowsAbsenceClaims": false,
    "registrationExecutesServer": false,
    "registrationGrantsAuthority": false,
    "doctorAuthorizesEffects": false,
    "doctorRepairScope": ".mcp.json workbench v2 registration only",
    "downstreamAdmissionRequired": true
  }
}

{
  "name": "@evavo/art-book-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./candidate-set": {
      "types": "./dist/candidate-set.d.ts",
      "import": "./dist/candidate-set.js"
    },
    "./docs-release": {
      "types": "./dist/docs-release.d.ts",
      "import": "./dist/docs-release.js"
    },
    "./inspection": {
      "types": "./dist/inspection.d.ts",
      "import": "./dist/inspection.js"
    },
    "./parity": {
      "types": "./dist/parity.d.ts",
      "import": "./dist/parity.js"
    },
    "./legacy-registration": {
      "types": "./dist/legacy-registration.d.ts",
      "import": "./dist/legacy-registration.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build --silent && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@evavo/art-artifacts": "workspace:*",
    "@evavo/art-contracts": "workspace:*",
    "@evavo/art-providers": "workspace:*",
    "@evavo/art-quality": "workspace:*",
    "@evavo/art-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.2"
  }
}

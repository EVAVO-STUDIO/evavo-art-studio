# Shared control-plane settings
HOST=127.0.0.1
PORT=4100
EVAVO_ART_ALLOWED_ORIGINS=http://localhost:4200
EVAVO_ART_ALLOWED_ROOTS=C:\GitRepos
EVAVO_ART_ARTIFACT_ROOT=.art-studio\artifacts

# File-generating API and MCP tools are disabled unless explicitly enabled.
# Local CLI commands remain deliberate user-invoked writes.
EVAVO_ART_ALLOW_WRITES=false

# Durable runtime, enabled in a later worker slice
DATABASE_URL=
EVAVO_ART_QUEUE_SCHEMA=evavo_art

# S3-compatible artifact storage, optional when local storage is used
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Provider credentials belong on workers, never in the browser
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
REPLICATE_API_TOKEN=

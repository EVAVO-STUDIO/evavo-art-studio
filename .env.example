# Shared control-plane settings
HOST=127.0.0.1
PORT=4100
EVAVO_ART_ALLOWED_ORIGINS=http://localhost:4200
EVAVO_ART_ALLOWED_ROOTS=C:\GitRepos
EVAVO_ART_IMPORT_ROOTS=C:\Users\Greg\Downloads;C:\EVAVO-Attachments
EVAVO_ART_RUNTIME_ROOT=.art-studio\runtime
EVAVO_ART_ARTIFACT_ROOT=.art-studio\artifacts
EVAVO_ART_ACTOR=

# File-generating API and MCP tools are disabled unless explicitly enabled.
# REST operational reads and writes additionally require this separate server-only
# control token of at least 32 bytes. MCP is local stdio and still requires the
# explicit write switch. CLI commands remain deliberate user-invoked writes.
EVAVO_ART_ALLOW_WRITES=false
EVAVO_ART_WRITE_TOKEN=

# Dedicated attachment/workspace writer. Import roots are read-only source roots;
# allowed roots are the only writable workspaces. The EVAVO Storage operator is a
# fixed server-side JSON argument array and can never be supplied by an MCP call.
EVAVO_ART_WORKSPACE_MAX_FILE_BYTES=2147483648
EVAVO_ART_WORKSPACE_MAX_BASE64_BYTES=16777216
EVAVO_ART_ALLOW_STORAGE_WRITES=false
EVAVO_STORAGE_OPERATOR_COMMAND_JSON=
EVAVO_ART_STORAGE_TIMEOUT_MS=1800000
EVAVO_ART_STORAGE_OUTPUT_LIMIT_BYTES=1048576

# Protected owner operations page at http://localhost:4200/operations.
# Use distinct random values for the owner access token, session-signing secret
# and API write token. None of these values may use a NEXT_PUBLIC_ prefix.
EVAVO_ART_OPERATOR_ACCESS_TOKEN=
EVAVO_ART_OPERATOR_SESSION_SECRET=
EVAVO_ART_OPERATOR_SESSION_SECONDS=28800
EVAVO_ART_API_BASE_URL=http://127.0.0.1:4100
EVAVO_ART_OPERATOR_API_TIMEOUT_MS=15000
EVAVO_ART_OPERATOR_RESPONSE_LIMIT_BYTES=8388608

# Local durable worker host. Leave queues empty to enable the media queue plus
# the provider queue automatically whenever at least one provider adapter exists.
# On Windows, explicitly configured queues are separated with semicolons.
EVAVO_ART_WORKER_ID=
EVAVO_ART_WORKER_QUEUES=
EVAVO_ART_WORKER_CONCURRENCY=1
EVAVO_ART_WORKER_POLL_MS=1000

# Provider adapters are worker-only. The fixture provider is deterministic test
# infrastructure and must remain disabled outside explicit tests or demonstrations.
EVAVO_ART_ENABLE_FIXTURE_PROVIDER=false
EVAVO_ART_OPENAI_IMAGE_MODEL=gpt-image-2
EVAVO_ART_OPENAI_IMAGE_MODELS=gpt-image-2,gpt-image-2-2026-04-21
EVAVO_ART_OPENAI_BASE_URL=https://api.openai.com/v1
EVAVO_ART_PROVIDER_MAX_RESPONSE_BYTES=134217728
OPENAI_ORGANIZATION=
OPENAI_PROJECT=

# PostgreSQL/pg-boss delivery transport for shared workers. The runtime journal,
# artifact hashes and evidence records remain authoritative outside the transport.
DATABASE_URL=
EVAVO_ART_QUEUE_SCHEMA=evavo_art
EVAVO_ART_DELIVERY_QUEUE_PREFIX=evavo-art
EVAVO_ART_PGBOSS_HEARTBEAT_SECONDS=30

# S3-compatible artifact storage adapter, optional when local content-addressed
# storage is used. The S3 adapter remains a later deployment slice.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Provider credentials belong on authenticated workers, never in the browser,
# briefs, runtime payloads, provider evidence or artifact descriptors.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
REPLICATE_API_TOKEN=

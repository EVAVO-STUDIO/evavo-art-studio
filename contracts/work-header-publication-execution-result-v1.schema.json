{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evavo.work-header-publication-execution-result.v1",
  "title": "EVAVO Work header publication execution result attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schemaSha256",
    "resultState",
    "claimReceiptPath",
    "claimReceiptSha256",
    "claimReceiptByteLength",
    "authorizationReceiptPath",
    "authorizationReceiptSha256",
    "authorizationReceiptByteLength",
    "transactionPlanReceiptPath",
    "transactionPlanReceiptSha256",
    "transactionPlanReceiptByteLength",
    "route",
    "candidateId",
    "candidateSha256",
    "candidateByteLength",
    "targetKind",
    "targetIdentifier",
    "previousTargetSnapshotSha256",
    "previousTargetSnapshotByteLength",
    "rollbackBackupSha256",
    "rollbackBackupByteLength",
    "postExecutionTargetPath",
    "postExecutionTargetSha256",
    "postExecutionTargetByteLength",
    "claimReverifiedBeforeAttestation",
    "candidateBytesReverified",
    "postExecutionTargetMatchesCandidate",
    "postExecutionTargetDiffersFromPreviousTarget",
    "rollbackBackupPreserved",
    "resultIsEvidenceOnly",
    "executionAllowed",
    "publicationAllowed",
    "cloudOverwriteAllowed",
    "websiteMutationAllowed"
  ],
  "properties": {
    "contract": { "const": "evavo.work-header-publication-execution-result.v1" },
    "schemaSha256": { "$ref": "#/$defs/sha256" },
    "resultState": { "const": "executed-verified" },
    "claimReceiptPath": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "claimReceiptSha256": { "$ref": "#/$defs/sha256" },
    "claimReceiptByteLength": { "type": "integer", "minimum": 1 },
    "authorizationReceiptPath": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "authorizationReceiptSha256": { "$ref": "#/$defs/sha256" },
    "authorizationReceiptByteLength": { "type": "integer", "minimum": 1 },
    "transactionPlanReceiptPath": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "transactionPlanReceiptSha256": { "$ref": "#/$defs/sha256" },
    "transactionPlanReceiptByteLength": { "type": "integer", "minimum": 1 },
    "route": { "type": "string", "pattern": "^/work/[a-z0-9-]+$" },
    "candidateId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "candidateSha256": { "$ref": "#/$defs/sha256" },
    "candidateByteLength": { "type": "integer", "minimum": 1 },
    "targetKind": { "enum": ["website-header-source-update", "cloudinary-stable-id-replacement"] },
    "targetIdentifier": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "previousTargetSnapshotSha256": { "$ref": "#/$defs/sha256" },
    "previousTargetSnapshotByteLength": { "type": "integer", "minimum": 1 },
    "rollbackBackupSha256": { "$ref": "#/$defs/sha256" },
    "rollbackBackupByteLength": { "type": "integer", "minimum": 1 },
    "postExecutionTargetPath": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "postExecutionTargetSha256": { "$ref": "#/$defs/sha256" },
    "postExecutionTargetByteLength": { "type": "integer", "minimum": 1 },
    "claimReverifiedBeforeAttestation": { "const": true },
    "candidateBytesReverified": { "const": true },
    "postExecutionTargetMatchesCandidate": { "const": true },
    "postExecutionTargetDiffersFromPreviousTarget": { "const": true },
    "rollbackBackupPreserved": { "const": true },
    "resultIsEvidenceOnly": { "const": true },
    "executionAllowed": { "const": false },
    "publicationAllowed": { "const": false },
    "cloudOverwriteAllowed": { "const": false },
    "websiteMutationAllowed": { "const": false }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

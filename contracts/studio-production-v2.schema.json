{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.evavo.com.au/studio/studio-production-v2.schema.json",
  "title": "EVAVO Studio Production Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "studioId",
    "repository",
    "runtime",
    "entrypoints",
    "contracts",
    "handoffs",
    "automation",
    "qualityGates",
    "authority",
    "ciWorkflow"
  ],
  "properties": {
    "schema": {"const": "evavo_studio_production_manifest_v2"},
    "studioId": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "repository": {"type": "string", "pattern": "^EVAVO-STUDIO/[A-Za-z0-9._-]+$"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "version"],
      "properties": {
        "language": {"enum": ["node", "python"]},
        "version": {"type": "string", "minLength": 1, "maxLength": 32}
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validate", "focused"],
      "properties": {
        "validate": {"$ref": "#/$defs/command"},
        "focused": {"$ref": "#/$defs/command"}
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "role"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
          "path": {"$ref": "#/$defs/relativePath"},
          "role": {"enum": ["shared", "producer", "consumer", "quality", "orchestration"]}
        }
      }
    },
    "handoffs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepts", "produces"],
      "properties": {
        "accepts": {"type": "array", "maxItems": 32, "items": {"type": "string"}, "uniqueItems": true},
        "produces": {"type": "array", "maxItems": 32, "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resumable", "atomicCheckpoints", "boundedRetries", "maxAttemptsPerStep", "targetedRepair", "replaySafe", "networkRequiredDuringValidation", "sourceMutationDuringValidation"],
      "properties": {
        "resumable": {"type": "boolean"},
        "atomicCheckpoints": {"type": "boolean"},
        "boundedRetries": {"type": "boolean"},
        "maxAttemptsPerStep": {"type": "integer", "minimum": 1, "maximum": 8},
        "targetedRepair": {"type": "boolean"},
        "replaySafe": {"type": "boolean"},
        "networkRequiredDuringValidation": {"const": false},
        "sourceMutationDuringValidation": {"const": false}
      }
    },
    "qualityGates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
      "uniqueItems": true
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automaticCreativeApproval", "automaticReleaseApproval", "automaticPublication", "automaticDeployment"],
      "properties": {
        "automaticCreativeApproval": {"const": false},
        "automaticReleaseApproval": {"const": false},
        "automaticPublication": {"const": false},
        "automaticDeployment": {"const": false}
      }
    },
    "ciWorkflow": {"type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml$"}
  },
  "$defs": {
    "relativePath": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f\\u007f]+$"},
    "command": {"type": "array", "minItems": 2, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 512}}
  }
}

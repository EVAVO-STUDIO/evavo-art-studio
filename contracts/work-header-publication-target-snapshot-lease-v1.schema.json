{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evavo.work-header-publication-target-snapshot-lease.v1",
  "title": "EVAVO Work Header Publication Target Snapshot Lease",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "positiveInt": { "type": "integer", "minimum": 1 }
  },
  "required": [
    "contract",
    "schemaSha256",
    "leaseState",
    "operation",
    "executionClaimReceiptPath",
    "executionClaimReceiptSha256",
    "executionClaimReceiptByteLength",
    "executionClaimContract",
    "route",
    "candidateId",
    "candidateSha256",
    "candidateByteLength",
    "targetKind",
    "targetIdentifier",
    "targetKeySha256",
    "currentTargetSha256",
    "currentTargetByteLength",
    "deterministicLeasePath",
    "singleActiveLeasePerTargetSnapshot",
    "publicationAndRollbackMutuallyExclusiveForSameTargetSnapshot",
    "claimReverified",
    "currentTargetReverified",
    "createOnlyLease",
    "leaseEvidenceOnly",
    "executionAllowed",
    "rollbackExecutionAllowed",
    "publicationAllowed",
    "cloudOverwriteAllowed",
    "websiteMutationAllowed"
  ],
  "properties": {
    "contract": { "const": "evavo.work-header-publication-target-snapshot-lease.v1" },
    "schemaSha256": { "$ref": "#/$defs/sha256" },
    "leaseState": { "const": "target-snapshot-leased-unexecuted" },
    "operation": { "enum": ["publication", "rollback"] },
    "executionClaimReceiptPath": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "executionClaimReceiptSha256": { "$ref": "#/$defs/sha256" },
    "executionClaimReceiptByteLength": { "$ref": "#/$defs/positiveInt" },
    "executionClaimContract": {
      "enum": [
        "evavo.work-header-publication-execution-claim.v1",
        "evavo.work-header-publication-rollback-execution-claim.v1"
      ]
    },
    "route": { "type": "string", "pattern": "^/work/[a-z0-9-]+$" },
    "candidateId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "candidateSha256": { "$ref": "#/$defs/sha256" },
    "candidateByteLength": { "$ref": "#/$defs/positiveInt" },
    "targetKind": { "enum": ["website-header-source-update", "cloudinary-stable-id-replacement"] },
    "targetIdentifier": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "targetKeySha256": { "$ref": "#/$defs/sha256" },
    "currentTargetSha256": { "$ref": "#/$defs/sha256" },
    "currentTargetByteLength": { "$ref": "#/$defs/positiveInt" },
    "deterministicLeasePath": { "const": true },
    "singleActiveLeasePerTargetSnapshot": { "const": true },
    "publicationAndRollbackMutuallyExclusiveForSameTargetSnapshot": { "const": true },
    "claimReverified": { "const": true },
    "currentTargetReverified": { "const": true },
    "createOnlyLease": { "const": true },
    "leaseEvidenceOnly": { "const": true },
    "executionAllowed": { "const": false },
    "rollbackExecutionAllowed": { "const": false },
    "publicationAllowed": { "const": false },
    "cloudOverwriteAllowed": { "const": false },
    "websiteMutationAllowed": { "const": false }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evavo.local/schemas/art-studio/handwriting-photo-registration.v1.schema.json",
  "title": "EVAVO Art Studio Handwriting Photo Registration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "page", "cornersPx"],
  "properties": {
    "schema": {"const": "evavo.art-studio.handwriting-photo-registration.v1"},
    "page": {"type": "integer", "minimum": 1, "maximum": 128},
    "cropMarginPx": {"type": "integer", "minimum": 0, "maximum": 512, "default": 36},
    "keepMarginPx": {"type": "integer", "minimum": 0, "maximum": 128, "default": 6},
    "cornersPx": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topLeft", "topRight", "bottomRight", "bottomLeft"],
      "properties": {
        "topLeft": {"$ref": "#/$defs/point"},
        "topRight": {"$ref": "#/$defs/point"},
        "bottomRight": {"$ref": "#/$defs/point"},
        "bottomLeft": {"$ref": "#/$defs/point"}
      }
    },
    "detectionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "fiducialCentersPx", "downsampleScale", "manualReviewRequired"],
      "properties": {
        "method": {"const": "solid-square-fiducials-v1"},
        "fiducialCentersPx": {
          "type": "object",
          "additionalProperties": false,
          "required": ["topLeft", "topRight", "bottomRight", "bottomLeft"],
          "properties": {
            "topLeft": {"$ref": "#/$defs/point"},
            "topRight": {"$ref": "#/$defs/point"},
            "bottomRight": {"$ref": "#/$defs/point"},
            "bottomLeft": {"$ref": "#/$defs/point"}
          }
        },
        "downsampleScale": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "manualReviewRequired": {"const": true}
      }
    },
    "reviewEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposalSha256", "decision", "cornersChanged", "manualReviewCompleted"],
      "properties": {
        "proposalSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "decision": {"const": "accept"},
        "cornersChanged": {"type": "boolean"},
        "manualReviewCompleted": {"const": true}
      }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0},
        {"type": "number", "minimum": 0}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    }
  }
}

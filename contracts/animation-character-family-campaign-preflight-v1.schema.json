{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.evavo.com.au/animation/animation-character-family-campaign-preflight-v1.schema.json",
  "title": "EVAVO Animation Character Family Campaign Preflight V1",
  "oneOf": [
    { "$ref": "#/$defs/manifest" },
    { "$ref": "#/$defs/report" },
    { "$ref": "#/$defs/verification" }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerExecution",
        "localExecution",
        "automaticCreativeApproval",
        "creativeApproval",
        "artifactPromotion",
        "repositoryMutation",
        "gitCommit",
        "gitPush",
        "runtimeActivation",
        "publication",
        "deployment"
      ],
      "properties": {
        "providerExecution": { "const": false },
        "localExecution": { "const": false },
        "automaticCreativeApproval": { "const": false },
        "creativeApproval": { "const": false },
        "artifactPromotion": { "const": false },
        "repositoryMutation": { "const": false },
        "gitCommit": { "const": false },
        "gitPush": { "const": false },
        "runtimeActivation": { "const": false },
        "publication": { "const": false },
        "deployment": { "const": false }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapterId",
        "ownerRole",
        "taskKinds",
        "kind",
        "enabled",
        "rootId",
        "workingDirectory",
        "entrypoint",
        "command",
        "timeoutMs",
        "maximumOutputBytes",
        "environmentVariables",
        "environmentPolicy"
      ],
      "properties": {
        "adapterId": { "$ref": "#/$defs/id" },
        "ownerRole": {
          "enum": ["art-studio", "cel-animation-studio"]
        },
        "taskKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "produce-clip",
              "repair-clip",
              "repair-transition",
              "repair-family",
              "review-family"
            ]
          }
        },
        "kind": { "enum": ["command", "module"] },
        "enabled": { "type": "boolean" },
        "rootId": { "$ref": "#/$defs/id" },
        "workingDirectory": { "type": "string", "minLength": 1 },
        "entrypoint": { "type": "string", "minLength": 1 },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1 }
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 3600000
        },
        "maximumOutputBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 67108864
        },
        "environmentVariables": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
          }
        },
        "environmentPolicy": { "enum": ["required", "optional"] },
        "implementationSha256": { "$ref": "#/$defs/digest" }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "protocolVersion",
        "manifestId",
        "campaignId",
        "familyPlanDigest",
        "adapters"
      ],
      "properties": {
        "schema": {
          "const": "evavo.animation-character-family-campaign-adapters.v1"
        },
        "protocolVersion": { "const": "2026-09-01.1" },
        "manifestId": { "$ref": "#/$defs/id" },
        "campaignId": { "$ref": "#/$defs/id" },
        "familyPlanDigest": { "$ref": "#/$defs/digest" },
        "adapters": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/adapter" }
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "protocolVersion",
        "reportId",
        "role",
        "manifestId",
        "manifestDigest",
        "campaignId",
        "familyPlanDigest",
        "status",
        "requiredTasks",
        "adapterObservations",
        "taskCoverage",
        "nextActions",
        "authority",
        "reportDigest"
      ],
      "properties": {
        "schema": {
          "const": "evavo.animation-character-family-campaign-preflight.report.v1"
        },
        "protocolVersion": { "const": "2026-09-01.1" },
        "reportId": { "$ref": "#/$defs/id" },
        "role": {
          "enum": ["art-studio", "cel-animation-studio", "coordinator"]
        },
        "manifestId": { "$ref": "#/$defs/id" },
        "manifestDigest": { "$ref": "#/$defs/digest" },
        "campaignId": { "$ref": "#/$defs/id" },
        "familyPlanDigest": { "$ref": "#/$defs/digest" },
        "status": { "enum": ["ready", "partial", "blocked"] },
        "requiredTasks": { "type": "array", "items": { "type": "string" } },
        "adapterObservations": { "type": "array", "items": { "type": "object" } },
        "taskCoverage": { "type": "array", "items": { "type": "object" } },
        "nextActions": { "type": "array", "items": { "type": "object" } },
        "authority": { "$ref": "#/$defs/authority" },
        "reportDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "protocolVersion",
        "reportId",
        "reportDigest",
        "status",
        "authority",
        "verificationDigest"
      ],
      "properties": {
        "schema": {
          "const": "evavo.animation-character-family-campaign-preflight.verification.v1"
        },
        "protocolVersion": { "const": "2026-09-01.1" },
        "reportId": { "$ref": "#/$defs/id" },
        "reportDigest": { "$ref": "#/$defs/digest" },
        "status": { "const": "verified" },
        "authority": { "$ref": "#/$defs/authority" },
        "verificationDigest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}

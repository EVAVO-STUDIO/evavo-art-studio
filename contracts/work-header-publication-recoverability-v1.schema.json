{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evavo.local/contracts/work-header-publication-recoverability-v1.schema.json",
  "title": "EVAVO Work Header Publication Recoverability Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schemaSha256",
    "recoverabilityState",
    "transactionStateReceiptPath",
    "transactionStateReceiptSha256",
    "transactionStateReceiptByteLength",
    "sourcePostflightReceiptPath",
    "sourcePostflightReceiptSha256",
    "sourcePostflightReceiptByteLength",
    "route",
    "candidateId",
    "candidateSha256",
    "candidateByteLength",
    "targetKind",
    "targetIdentifier",
    "liveTargetReference",
    "liveTargetSha256",
    "liveTargetByteLength",
    "rollbackBackupPath",
    "rollbackBackupSha256",
    "rollbackBackupByteLength",
    "transactionStateReverified",
    "sourcePostflightBindingReverified",
    "liveTargetReverified",
    "liveTargetMatchesCandidate",
    "rollbackBackupReverified",
    "rollbackBackupDiffersFromCandidate",
    "targetAwareLiveRecheckRequired",
    "recoverabilityEvidenceOnly",
    "executionAllowed",
    "rollbackExecutionAllowed",
    "publicationAllowed",
    "cloudOverwriteAllowed",
    "websiteMutationAllowed"
  ],
  "properties": {
    "contract": { "const": "evavo.work-header-publication-recoverability.v1" },
    "schemaSha256": { "$ref": "#/$defs/sha256" },
    "recoverabilityState": { "const": "published-rollback-recovery-ready" },
    "transactionStateReceiptPath": { "type": "string", "minLength": 1 },
    "transactionStateReceiptSha256": { "$ref": "#/$defs/sha256" },
    "transactionStateReceiptByteLength": { "type": "integer", "minimum": 1 },
    "sourcePostflightReceiptPath": { "type": "string", "minLength": 1 },
    "sourcePostflightReceiptSha256": { "$ref": "#/$defs/sha256" },
    "sourcePostflightReceiptByteLength": { "type": "integer", "minimum": 1 },
    "route": { "type": "string", "pattern": "^/work/" },
    "candidateId": { "type": "string", "minLength": 1 },
    "candidateSha256": { "$ref": "#/$defs/sha256" },
    "candidateByteLength": { "type": "integer", "minimum": 1 },
    "targetKind": { "enum": ["website-header-source-update", "cloudinary-stable-id-replacement"] },
    "targetIdentifier": { "type": "string", "minLength": 1 },
    "liveTargetReference": { "type": "string", "minLength": 1 },
    "liveTargetSha256": { "$ref": "#/$defs/sha256" },
    "liveTargetByteLength": { "type": "integer", "minimum": 1 },
    "rollbackBackupPath": { "type": "string", "minLength": 1 },
    "rollbackBackupSha256": { "$ref": "#/$defs/sha256" },
    "rollbackBackupByteLength": { "type": "integer", "minimum": 1 },
    "transactionStateReverified": { "const": true },
    "sourcePostflightBindingReverified": { "const": true },
    "liveTargetReverified": { "const": true },
    "liveTargetMatchesCandidate": { "const": true },
    "rollbackBackupReverified": { "const": true },
    "rollbackBackupDiffersFromCandidate": { "const": true },
    "targetAwareLiveRecheckRequired": { "const": true },
    "recoverabilityEvidenceOnly": { "const": true },
    "executionAllowed": { "const": false },
    "rollbackExecutionAllowed": { "const": false },
    "publicationAllowed": { "const": false },
    "cloudOverwriteAllowed": { "const": false },
    "websiteMutationAllowed": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}

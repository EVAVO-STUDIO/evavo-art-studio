{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.evavo.com.au/animation/animation-character-family-v1.schema.json",
  "title": "EVAVO Animation Character Family V1",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/plan" },
    { "$ref": "#/$defs/clipEvidence" },
    { "$ref": "#/$defs/status" },
    { "$ref": "#/$defs/reviewInput" },
    { "$ref": "#/$defs/assessment" },
    { "$ref": "#/$defs/reviewReceipt" },
    { "$ref": "#/$defs/runtimePlan" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "safeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$" },
    "authority": {
      "type": "object",
      "required": ["providerExecution", "creativeApproval", "artifactPromotion", "targetRepositoryMutation", "runtimeActivation", "publication"],
      "properties": {
        "providerExecution": { "const": false },
        "automaticCreativeApproval": { "const": false },
        "creativeApproval": { "const": false },
        "artifactPromotion": { "const": false },
        "targetRepositoryMutation": { "const": false },
        "gitCommit": { "const": false },
        "gitPush": { "const": false },
        "runtimeActivation": { "const": false },
        "publication": { "const": false },
        "deployment": { "const": false }
      },
      "additionalProperties": false
    },
    "base": {
      "type": "object",
      "required": ["schema", "protocolVersion"],
      "properties": { "protocolVersion": { "const": "2026-09-01.2" } }
    },
    "request": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["schema", "familyId", "revision", "projectId", "title", "subject", "style", "camera", "delivery", "coverage", "timing"],
          "properties": {
            "schema": { "const": "evavo.animation-character-family.request.v1" },
            "familyId": { "$ref": "#/$defs/safeId" },
            "revision": { "type": "integer", "minimum": 1 },
            "projectId": { "$ref": "#/$defs/safeId" },
            "title": { "type": "string", "minLength": 1 },
            "subject": { "type": "object" },
            "style": { "type": "object" },
            "camera": { "type": "object" },
            "delivery": { "type": "object" },
            "coverage": { "type": "object" },
            "timing": { "type": "object" }
          }
        }
      ]
    },
    "plan": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["schema", "familyId", "revision", "request", "locks", "slots", "transitions", "summary", "authority", "planDigest"],
          "properties": {
            "schema": { "const": "evavo.animation-character-family.plan.v1" },
            "familyId": { "$ref": "#/$defs/safeId" },
            "slots": { "type": "array", "minItems": 1 },
            "transitions": { "type": "array" },
            "authority": { "$ref": "#/$defs/authority" },
            "planDigest": { "$ref": "#/$defs/digest" }
          }
        }
      ]
    },
    "clipEvidence": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["schema", "familyId", "planDigest", "slotId", "delivery", "creativeApproval", "clipDigest"],
          "properties": {
            "schema": { "const": "evavo.animation-character-family.clip-evidence.v1" },
            "planDigest": { "$ref": "#/$defs/digest" },
            "clipDigest": { "$ref": "#/$defs/digest" },
            "delivery": { "type": "object" },
            "creativeApproval": { "type": "object" }
          }
        }
      ]
    },
    "status": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["schema", "familyId", "planDigest", "status", "nextWork", "summary", "authority", "statusDigest"],
          "properties": {
            "schema": { "const": "evavo.animation-character-family.status.v1" },
            "planDigest": { "$ref": "#/$defs/digest" },
            "statusDigest": { "$ref": "#/$defs/digest" },
            "nextWork": { "type": "array" },
            "authority": { "$ref": "#/$defs/authority" }
          }
        }
      ]
    },
    "reviewInput": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["schema", "familyId", "planDigest", "clips", "reviewChecks", "reviewInputDigest"],
          "properties": {
            "schema": { "const": "evavo.animation-character-family.review-input.v1" },
            "planDigest": { "$ref": "#/$defs/digest" },
            "reviewInputDigest": { "$ref": "#/$defs/digest" },
            "clips": { "type": "array", "minItems": 1 }
          }
        }
      ]
    },
    "assessment": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["schema", "status", "reviewer", "findings"],
          "properties": {
            "schema": { "const": "evavo.animation-character-family.review-assessment.v1" },
            "status": { "enum": ["accepted", "rework-required", "blocked"] },
            "findings": { "type": "array" }
          }
        }
      ]
    },
    "reviewReceipt": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["schema", "receiptId", "familyId", "planDigest", "reviewInputDigest", "status", "authority", "receiptDigest"],
          "properties": {
            "schema": { "const": "evavo.animation-character-family.review-receipt.v1" },
            "planDigest": { "$ref": "#/$defs/digest" },
            "reviewInputDigest": { "$ref": "#/$defs/digest" },
            "receiptDigest": { "$ref": "#/$defs/digest" },
            "authority": { "$ref": "#/$defs/authority" }
          }
        }
      ]
    },
    "runtimePlan": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["schema", "familyId", "planDigest", "reviewReceiptDigest", "states", "transitions", "destinations", "authority", "runtimePlanDigest"],
          "properties": {
            "schema": { "const": "evavo.animation-character-family.runtime-plan.v1" },
            "planDigest": { "$ref": "#/$defs/digest" },
            "reviewReceiptDigest": { "$ref": "#/$defs/digest" },
            "runtimePlanDigest": { "$ref": "#/$defs/digest" },
            "states": { "type": "array", "minItems": 1 },
            "transitions": { "type": "array" },
            "destinations": { "type": "object" },
            "authority": { "$ref": "#/$defs/authority" }
          }
        }
      ]
    }
  }
}

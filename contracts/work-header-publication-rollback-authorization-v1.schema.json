{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evavo.work-header-publication-rollback-authorization.v1",
  "title": "EVAVO Work Header Publication Rollback Authorization",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "positiveInt": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "contract",
    "schemaSha256",
    "authorizationState",
    "rollbackReadinessReceiptPath",
    "rollbackReadinessReceiptSha256",
    "rollbackReadinessReceiptByteLength",
    "publicationPostflightReceiptPath",
    "publicationPostflightReceiptSha256",
    "publicationPostflightReceiptByteLength",
    "recoverabilityReceiptPath",
    "recoverabilityReceiptSha256",
    "recoverabilityReceiptByteLength",
    "route",
    "candidateId",
    "candidateSha256",
    "candidateByteLength",
    "targetKind",
    "targetIdentifier",
    "publishedTargetSha256",
    "publishedTargetByteLength",
    "rollbackBackupSha256",
    "rollbackBackupByteLength",
    "previousTargetSnapshotSha256",
    "previousTargetSnapshotByteLength",
    "confirmationStatement",
    "explicitRollbackConfirmation",
    "rollbackReadinessReverified",
    "publicationPostflightReverified",
    "recoverabilityReverified",
    "recoverabilityLiveTargetMatchedCandidateAtVerification",
    "recoverabilityRollbackBackupStillReady",
    "postflightLiveTargetMatchedCandidateAtVerification",
    "postflightRollbackBackupStillReady",
    "currentPublishedTargetStillMatchesCandidate",
    "rollbackBackupStillMatchesPreviousTarget",
    "rollbackAuthorizedForOneTransactionOnly",
    "authorizationExpiresOnAnyEvidenceDrift",
    "rollbackExecutionAllowed",
    "publicationAllowed",
    "cloudOverwriteAllowed",
    "websiteMutationAllowed"
  ],
  "properties": {
    "contract": {
      "const": "evavo.work-header-publication-rollback-authorization.v1"
    },
    "schemaSha256": {
      "$ref": "#/$defs/sha256"
    },
    "authorizationState": {
      "const": "rollback-authorized-unexecuted"
    },
    "rollbackReadinessReceiptPath": {
      "$ref": "#/$defs/path"
    },
    "publicationPostflightReceiptPath": {
      "$ref": "#/$defs/path"
    },
    "recoverabilityReceiptPath": {
      "$ref": "#/$defs/path"
    },
    "rollbackReadinessReceiptSha256": {
      "$ref": "#/$defs/sha256"
    },
    "publicationPostflightReceiptSha256": {
      "$ref": "#/$defs/sha256"
    },
    "recoverabilityReceiptSha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidateSha256": {
      "$ref": "#/$defs/sha256"
    },
    "publishedTargetSha256": {
      "$ref": "#/$defs/sha256"
    },
    "rollbackBackupSha256": {
      "$ref": "#/$defs/sha256"
    },
    "previousTargetSnapshotSha256": {
      "$ref": "#/$defs/sha256"
    },
    "rollbackReadinessReceiptByteLength": {
      "$ref": "#/$defs/positiveInt"
    },
    "publicationPostflightReceiptByteLength": {
      "$ref": "#/$defs/positiveInt"
    },
    "recoverabilityReceiptByteLength": {
      "$ref": "#/$defs/positiveInt"
    },
    "candidateByteLength": {
      "$ref": "#/$defs/positiveInt"
    },
    "publishedTargetByteLength": {
      "$ref": "#/$defs/positiveInt"
    },
    "rollbackBackupByteLength": {
      "$ref": "#/$defs/positiveInt"
    },
    "previousTargetSnapshotByteLength": {
      "$ref": "#/$defs/positiveInt"
    },
    "route": {
      "type": "string",
      "pattern": "^/work/[a-z0-9-]+$"
    },
    "candidateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "targetKind": {
      "enum": [
        "website-header-source-update",
        "cloudinary-stable-id-replacement"
      ]
    },
    "targetIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "confirmationStatement": {
      "const": "I explicitly authorize rollback of this exact reviewed Work-header publication transaction."
    },
    "explicitRollbackConfirmation": {
      "const": true
    },
    "rollbackReadinessReverified": {
      "const": true
    },
    "publicationPostflightReverified": {
      "const": true
    },
    "recoverabilityReverified": {
      "const": true
    },
    "recoverabilityLiveTargetMatchedCandidateAtVerification": {
      "const": true
    },
    "recoverabilityRollbackBackupStillReady": {
      "const": true
    },
    "postflightLiveTargetMatchedCandidateAtVerification": {
      "const": true
    },
    "postflightRollbackBackupStillReady": {
      "const": true
    },
    "currentPublishedTargetStillMatchesCandidate": {
      "const": true
    },
    "rollbackBackupStillMatchesPreviousTarget": {
      "const": true
    },
    "rollbackAuthorizedForOneTransactionOnly": {
      "const": true
    },
    "authorizationExpiresOnAnyEvidenceDrift": {
      "const": true
    },
    "rollbackExecutionAllowed": {
      "const": false
    },
    "publicationAllowed": {
      "const": false
    },
    "cloudOverwriteAllowed": {
      "const": false
    },
    "websiteMutationAllowed": {
      "const": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evavo.work-header-publication-rollback-authorization.v1",
  "title": "EVAVO Work Header Publication Rollback Authorization",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096},
    "positiveInt": {"type": "integer", "minimum": 1}
  },
  "required": [
    "contract","schemaSha256","authorizationState","rollbackReadinessReceiptPath",
    "rollbackReadinessReceiptSha256","rollbackReadinessReceiptByteLength","route",
    "candidateId","candidateSha256","candidateByteLength","targetKind","targetIdentifier",
    "publishedTargetSha256","publishedTargetByteLength","rollbackBackupSha256",
    "rollbackBackupByteLength","previousTargetSnapshotSha256","previousTargetSnapshotByteLength",
    "confirmationStatement","explicitRollbackConfirmation","rollbackReadinessReverified",
    "currentPublishedTargetStillMatchesCandidate","rollbackBackupStillMatchesPreviousTarget",
    "rollbackAuthorizedForOneTransactionOnly","authorizationExpiresOnAnyEvidenceDrift",
    "rollbackExecutionAllowed","publicationAllowed","cloudOverwriteAllowed","websiteMutationAllowed"
  ],
  "properties": {
    "contract": {"const": "evavo.work-header-publication-rollback-authorization.v1"},
    "schemaSha256": {"$ref": "#/$defs/sha256"},
    "authorizationState": {"const": "rollback-authorized-unexecuted"},
    "rollbackReadinessReceiptPath": {"$ref": "#/$defs/path"},
    "rollbackReadinessReceiptSha256": {"$ref": "#/$defs/sha256"},
    "rollbackReadinessReceiptByteLength": {"$ref": "#/$defs/positiveInt"},
    "route": {"type": "string", "pattern": "^/work/[a-z0-9-]+$"},
    "candidateId": {"type": "string", "minLength": 1, "maxLength": 160},
    "candidateSha256": {"$ref": "#/$defs/sha256"},
    "candidateByteLength": {"$ref": "#/$defs/positiveInt"},
    "targetKind": {"enum": ["website-header-source-update","cloudinary-stable-id-replacement"]},
    "targetIdentifier": {"type": "string", "minLength": 1, "maxLength": 4096},
    "publishedTargetSha256": {"$ref": "#/$defs/sha256"},
    "publishedTargetByteLength": {"$ref": "#/$defs/positiveInt"},
    "rollbackBackupSha256": {"$ref": "#/$defs/sha256"},
    "rollbackBackupByteLength": {"$ref": "#/$defs/positiveInt"},
    "previousTargetSnapshotSha256": {"$ref": "#/$defs/sha256"},
    "previousTargetSnapshotByteLength": {"$ref": "#/$defs/positiveInt"},
    "confirmationStatement": {"const": "I explicitly authorize rollback of this exact reviewed Work-header publication transaction."},
    "explicitRollbackConfirmation": {"const": true},
    "rollbackReadinessReverified": {"const": true},
    "currentPublishedTargetStillMatchesCandidate": {"const": true},
    "rollbackBackupStillMatchesPreviousTarget": {"const": true},
    "rollbackAuthorizedForOneTransactionOnly": {"const": true},
    "authorizationExpiresOnAnyEvidenceDrift": {"const": true},
    "rollbackExecutionAllowed": {"const": false},
    "publicationAllowed": {"const": false},
    "cloudOverwriteAllowed": {"const": false},
    "websiteMutationAllowed": {"const": false}
  }
}

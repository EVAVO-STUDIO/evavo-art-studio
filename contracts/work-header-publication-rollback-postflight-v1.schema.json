{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evavo.work-header-publication-rollback-postflight.v1",
  "title": "EVAVO Work header publication rollback postflight verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schemaSha256",
    "rollbackPostflightState",
    "rollbackExecutionResultReceiptPath",
    "rollbackExecutionResultReceiptSha256",
    "rollbackExecutionResultReceiptByteLength",
    "publicationPostflightReceiptPath",
    "publicationPostflightReceiptSha256",
    "publicationPostflightReceiptByteLength",
    "route",
    "candidateId",
    "candidateSha256",
    "candidateByteLength",
    "targetKind",
    "targetIdentifier",
    "liveTargetPath",
    "liveTargetSha256",
    "liveTargetByteLength",
    "previousTargetSnapshotSha256",
    "previousTargetSnapshotByteLength",
    "rollbackBackupPath",
    "rollbackBackupSha256",
    "rollbackBackupByteLength",
    "rollbackExecutionResultReverified",
    "publicationPostflightLineageReverified",
    "liveTargetReverified",
    "liveTargetMatchesPreviousTarget",
    "liveTargetDiffersFromCandidate",
    "rollbackBackupStillMatchesLiveTarget",
    "transactionClosedAfterVerifiedRollback",
    "rollbackPostflightEvidenceOnly",
    "executionAllowed",
    "rollbackExecutionAllowed",
    "publicationAllowed",
    "cloudOverwriteAllowed",
    "websiteMutationAllowed"
  ],
  "properties": {
    "contract": { "const": "evavo.work-header-publication-rollback-postflight.v1" },
    "schemaSha256": { "$ref": "#/$defs/sha256" },
    "rollbackPostflightState": { "const": "rolled-back-verified-closed" },
    "rollbackExecutionResultReceiptPath": { "type": "string", "minLength": 1 },
    "rollbackExecutionResultReceiptSha256": { "$ref": "#/$defs/sha256" },
    "rollbackExecutionResultReceiptByteLength": { "type": "integer", "minimum": 1 },
    "publicationPostflightReceiptPath": { "type": "string", "minLength": 1 },
    "publicationPostflightReceiptSha256": { "$ref": "#/$defs/sha256" },
    "publicationPostflightReceiptByteLength": { "type": "integer", "minimum": 1 },
    "route": { "type": "string", "pattern": "^/work/[a-z0-9-]+$" },
    "candidateId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "candidateSha256": { "$ref": "#/$defs/sha256" },
    "candidateByteLength": { "type": "integer", "minimum": 1 },
    "targetKind": { "enum": ["website-header-source-update", "cloudinary-stable-id-replacement"] },
    "targetIdentifier": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "liveTargetPath": { "type": "string", "minLength": 1 },
    "liveTargetSha256": { "$ref": "#/$defs/sha256" },
    "liveTargetByteLength": { "type": "integer", "minimum": 1 },
    "previousTargetSnapshotSha256": { "$ref": "#/$defs/sha256" },
    "previousTargetSnapshotByteLength": { "type": "integer", "minimum": 1 },
    "rollbackBackupPath": { "type": "string", "minLength": 1 },
    "rollbackBackupSha256": { "$ref": "#/$defs/sha256" },
    "rollbackBackupByteLength": { "type": "integer", "minimum": 1 },
    "rollbackExecutionResultReverified": { "const": true },
    "publicationPostflightLineageReverified": { "const": true },
    "liveTargetReverified": { "const": true },
    "liveTargetMatchesPreviousTarget": { "const": true },
    "liveTargetDiffersFromCandidate": { "const": true },
    "rollbackBackupStillMatchesLiveTarget": { "const": true },
    "transactionClosedAfterVerifiedRollback": { "const": true },
    "rollbackPostflightEvidenceOnly": { "const": true },
    "executionAllowed": { "const": false },
    "rollbackExecutionAllowed": { "const": false },
    "publicationAllowed": { "const": false },
    "cloudOverwriteAllowed": { "const": false },
    "websiteMutationAllowed": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}

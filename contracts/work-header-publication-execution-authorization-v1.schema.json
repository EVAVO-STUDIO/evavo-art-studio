{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evavo.work-header-publication-execution-authorization.v1",
  "title": "EVAVO Work header publication execution authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schemaSha256",
    "authorizationState",
    "transactionPlanReceiptPath",
    "transactionPlanReceiptSha256",
    "transactionPlanReceiptByteLength",
    "route",
    "candidateId",
    "candidateSha256",
    "candidateByteLength",
    "targetKind",
    "targetIdentifier",
    "currentTargetSnapshotSha256",
    "currentTargetSnapshotByteLength",
    "rollbackBackupSha256",
    "rollbackBackupByteLength",
    "explicitExecutionConfirmation",
    "confirmationStatement",
    "transactionPlanReverified",
    "candidateBytesReverified",
    "currentTargetStillMatchesSnapshot",
    "rollbackBackupStillMatchesSnapshot",
    "executionAuthorizedForOneTransactionOnly",
    "authorizationExpiresOnAnyEvidenceDrift",
    "executionAllowed",
    "publicationAllowed",
    "cloudOverwriteAllowed",
    "websiteMutationAllowed"
  ],
  "properties": {
    "contract": { "const": "evavo.work-header-publication-execution-authorization.v1" },
    "schemaSha256": { "$ref": "#/$defs/sha256" },
    "authorizationState": { "const": "authorized-unexecuted" },
    "transactionPlanReceiptPath": { "type": "string", "minLength": 1 },
    "transactionPlanReceiptSha256": { "$ref": "#/$defs/sha256" },
    "transactionPlanReceiptByteLength": { "type": "integer", "minimum": 1 },
    "route": { "type": "string", "pattern": "^/work/[a-z0-9-]+$" },
    "candidateId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "candidateSha256": { "$ref": "#/$defs/sha256" },
    "candidateByteLength": { "type": "integer", "minimum": 1 },
    "targetKind": { "enum": ["website-header-source-update", "cloudinary-stable-id-replacement"] },
    "targetIdentifier": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "currentTargetSnapshotSha256": { "$ref": "#/$defs/sha256" },
    "currentTargetSnapshotByteLength": { "type": "integer", "minimum": 1 },
    "rollbackBackupSha256": { "$ref": "#/$defs/sha256" },
    "rollbackBackupByteLength": { "type": "integer", "minimum": 1 },
    "explicitExecutionConfirmation": { "const": true },
    "confirmationStatement": { "const": "I explicitly authorize execution of this exact reviewed publication transaction." },
    "transactionPlanReverified": { "const": true },
    "candidateBytesReverified": { "const": true },
    "currentTargetStillMatchesSnapshot": { "const": true },
    "rollbackBackupStillMatchesSnapshot": { "const": true },
    "executionAuthorizedForOneTransactionOnly": { "const": true },
    "authorizationExpiresOnAnyEvidenceDrift": { "const": true },
    "executionAllowed": { "const": false },
    "publicationAllowed": { "const": false },
    "cloudOverwriteAllowed": { "const": false },
    "websiteMutationAllowed": { "const": false }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

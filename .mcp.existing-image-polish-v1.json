{
  "mcpServers": {
    "evavo-existing-image-restoration-intake-v1": {
      "command": "node",
      "args": ["tools/existing_image_restoration_intake_mcp.mjs"],
      "env": {
        "EVAVO_REFERENCE_COLOUR_RESTORATION_PROVIDER": "evavo-image-enhancement-studio:reference-colourization-v1"
      }
    },
    "evavo-reference-colour-restoration-bridge-v1": {
      "command": "node",
      "args": ["tools/reference_colour_restoration_guarded_mcp.mjs"],
      "env": {
        "EVAVO_EXISTING_IMAGE_POLISH_ALLOWED_ROOTS": "C:\\GitRepos;%LOCALAPPDATA%\\EVAVO;%USERPROFILE%\\Downloads;C:\\EVAVO;D:\\EVAVO",
        "EVAVO_REFERENCE_COLOUR_RESTORATION_ALLOW_EXECUTION": "true",
        "EVAVO_REFERENCE_COLOUR_RESTORATION_ENHANCER_ROOT": "C:\\GitRepos\\evavo-image-enhancement-studio",
        "EVAVO_LOCAL_COMPUTE_ROOT": "C:\\GitRepos\\evavo-local-compute"
      }
    },
    "evavo-existing-image-polish-v1": {
      "command": "node",
      "args": ["tools/existing_image_polish_mcp.mjs"],
      "env": {
        "EVAVO_EXISTING_IMAGE_POLISH_ALLOWED_ROOTS": "C:\\GitRepos;%LOCALAPPDATA%\\EVAVO;%USERPROFILE%\\Downloads;C:\\EVAVO;D:\\EVAVO",
        "EVAVO_EXISTING_IMAGE_POLISH_ALLOW_WRITES": "true"
      }
    }
  }
}

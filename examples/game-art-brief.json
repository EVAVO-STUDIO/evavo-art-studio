    "mustAvoid": [
      "fake transparency checkerboards",
      "modern objects or signage",
      "photorealistic rendering",
      "glossy generic AI lighting",
      "random detail drift between frames",
      "cropped limbs or weapons"
    ],
    "palette": {
      "colours": ["#000000", "#ffffff", "#ff244e"],
      "maxColours": 16,
      "colourSpace": "srgb"
    },
    "era": "1871",
    "cameraRules": ["fixed front-on or side-stage", "clear horizontal floor lane", "no isometric camera"],
    "lineTreatment": "DOS-era engraved linework with purposeful one-pixel clusters",
    "materialLanguage": ["weathered timber", "iron", "canvas", "wool", "leather"]
  },
  "assets": [

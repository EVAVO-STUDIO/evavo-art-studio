          6,
          9
        ],
        "pivot": {
          "x": 32,
          "y": 32
        }
      },
      "sprite": {
        "productionMethod": "authored-cel",
        "shot": {
          "safePadding": 2,
          "backgroundPolicy": "transparent",
          "allowCrop": false,
          "shadowPolicy": "none"
        },
        "continuityLocks": [
          "silhouette-language",
          "palette",
          "line-treatment",
          "pivot"
        ],
        "allowedChanges": [
          "streak length",
          "droplet breakup",
          "declared particle deformation"
        ]
      },
      "outputs": [
        {
          "format": "png",
          "purpose": "runtime",
          "lossless": true,
          "colourSpace": "srgb"
        },
        {
          "format": "json",
          "purpose": "manifest",
          "lossless": true
        }
      ]
    }
  ],
  "autonomy": {
    "mode": "fully-automatic",
    "candidateCount": 8,
    "maximumIterations": 5,
    "autoApproveThreshold": 0.95,
    "allowProviderFallback": true,
    "requireEvidenceBundle": true
  },
  "outputRoot": "art-studio-output"
}

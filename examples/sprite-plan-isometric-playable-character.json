{
  "schemaVersion": "1.0",
  "planId": "brass-brine-deckhand-complete-family",
  "artDirectionRequest": {
    "schemaVersion": "1.0",
    "contractId": "brass-brine-deckhand-family-direction",
    "presetId": "isometric-rpg-1997",
    "project": {
      "projectId": "brass-brine",
      "title": "Brass & Brine",
      "engine": "Godot",
      "engineVersion": "4.6.2",
      "gameGenre": "historical maritime trading action role-playing game",
      "targetPlatform": "desktop and mobile",
      "viewport": { "width": 1280, "height": 720 },
      "worldScale": {
        "pixelsPerTile": 64,
        "characterHeightPixels": 96,
        "tileWidthPixels": 64,
        "tileHeightPixels": 32
      }
    },
    "style": {
      "intent": "Create one complete late-1990s isometric deckhand family that remains historically plausible, readable at gameplay scale, and identical in identity, clothing, palette, lighting and projection across every direction, clip and frame.",
      "mustHave": [
        "clear deckhand silhouette at gameplay scale",
        "historically plausible 1871 work clothing",
        "stable coat, cap, boots and body proportions",
        "readable feet and ground contact",
        "consistent south, diagonal, side and north silhouettes"
      ],
      "mustAvoid": [
        "generic fantasy armour",
        "modern tactical equipment",
        "random straps, pouches or glowing accents",
        "different lighting between directions",
        "independent frame redesign",
        "contact sheets generated by the image provider"
      ],
      "materialLanguage": [
        "worn wool and canvas",
        "salt-dulled leather",
        "restrained brass and iron fittings"
      ],
      "antiGeneric": {
        "requiredDistinctiveMotifs": [
          "Reconstruction-era maritime workwear",
          "project-specific deckhand coat and cap construction"
        ],
        "prohibitedGenericMotifs": [
          "AI-like ornamental clutter",
          "fantasy pirate costume",
          "random smoke or magical atmosphere"
        ],
        "prohibitUnrequestedProps": true,
        "prohibitReadableText": true,
        "prohibitWatermarks": true,
        "prohibitModernGloss": true,
        "prohibitRandomMicrodetail": true,
        "prohibitStyleDrift": true,
        "requireHistoricalPlausibility": true
      },
      "references": [
        {
          "id": "deckhand-identity-master",
          "role": "identity",
          "uri": "artifact://projects/brass-brine/characters/deckhand/canonical-identity",
          "weight": 1,
          "rights": "EVAVO project-owned source art."
        },
        {
          "id": "brass-brine-palette",
          "role": "palette",
          "uri": "artifact://projects/brass-brine/style/palette-master",
          "weight": 1,
          "rights": "EVAVO project-owned style asset."
        },
        {
          "id": "maritime-1871-reference",
          "role": "historical",
          "uri": "reference://brass-brine/research/1871-maritime-workwear",
          "weight": 0.9,
          "rights": "Research reference only; do not copy protected artwork."
        }
      ]
    },
    "asset": {
      "assetId": "deckhand",
      "family": "character",
      "purpose": "Complete eight-direction playable deckhand sprite family with locomotion, combat, interaction, damage and performance states.",
      "dimensions": { "width": 96, "height": 128 },
      "transparency": "required",
      "animated": true,
      "frameCount": 8,
      "framesPerSecond": 8,
      "loop": true,
      "directionCount": 8,
      "directionNames": [
        "south",
        "south-west",
        "west",
        "north-west",
        "north",
        "north-east",
        "east",
        "south-east"
      ],
      "asymmetric": true,
      "hasHeldItems": true,
      "runtimeEquipmentSwaps": true,
      "runtimeCostumeVariants": true,
      "independentEffects": true,
      "independentShadow": true,
      "needsCollision": true,
      "needsNormalMap": true,
      "largeDeformations": true,
      "secondaryMotion": ["equipment"],
      "tileFootprint": { "width": 1, "height": 1 }
    },
    "outputProfileIds": ["godot-4.6.2-isometric-character"],
    "layerOverrides": [
      {
        "role": "shadow",
        "treatment": "linked-cel",
        "reason": "Retain registered shadow reuse only where the footprint and gait phase genuinely remain identical; moving phases may author distinct linked sources."
      },
      {
        "role": "collision",
        "treatment": "engine-sidecar",
        "reason": "Collision remains deterministic Godot metadata and never visible colour artwork."
      }
    ]
  },
  "role": "playable-character",
  "gameplayProfile": "action-rpg",
  "coverage": "complete",
  "fidelity": "premium",
  "includeFeatures": [
    "jump",
    "ranged",
    "aim",
    "reload",
    "parry",
    "talk",
    "gesture",
    "pickup",
    "spawn",
    "despawn"
  ],
  "allowDerivedMirrors": false,
  "variants": {
    "costumeVariants": 3,
    "equipmentVariants": 2,
    "weaponVariants": 4,
    "teamColourVariants": 4,
    "damageVariants": 2
  },
  "clipOverrides": [
    {
      "id": "idle",
      "framesPerDirection": 8,
      "framesPerSecond": 7,
      "loopMode": "linear",
      "keyPoseFrames": [0, 4, 7],
      "reason": "Longer premium idle with restrained breathing, coat and equipment settling."
    },
    {
      "id": "walk",
      "framesPerDirection": 8,
      "framesPerSecond": 9,
      "loopMode": "linear",
      "keyPoseFrames": [0, 2, 4, 6, 7],
      "reason": "Eight-frame contact, down, passing and up gait with an explicit loop endpoint review."
    },
    {
      "id": "ship-rigging-swing",
      "include": true,
      "framesPerDirection": 12,
      "framesPerSecond": 12,
      "loopMode": "none",
      "keyPoseFrames": [0, 4, 8, 11],
      "reason": "Project-specific traversal action for swinging between ship rigging lines."
    }
  ],
  "output": {
    "sheetStrategy": "per-clip-layer-grid",
    "maximumSheetSize": 4096,
    "includeAsepriteExport": true,
    "includePerClipSheets": true,
    "includeFamilyAtlas": true,
    "includeGodotResources": true
  },
  "metadata": {
    "owner": "EVAVO Studio",
    "releaseIntent": "Complete gameplay sprite source and Godot delivery family"
  }
}

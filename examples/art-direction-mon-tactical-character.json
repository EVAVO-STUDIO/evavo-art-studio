{
  "schemaVersion": "1.0",
  "contractId": "mon-household-spearman-eight-direction",
  "presetId": "isometric-rpg-1997",
  "project": {
    "projectId": "moonstone-wales",
    "title": "MÔN: Ashen Annwn",
    "engine": "Godot",

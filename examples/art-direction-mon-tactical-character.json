    "gameGenre": "historical mythic real-time tactical game",
    "targetPlatform": "desktop",
    "viewport": {"width":1280,"height":720},
    "worldScale": {"pixelsPerTile":64,"characterHeightPixels":112,"tileWidthPixels":64,"tileHeightPixels":32}

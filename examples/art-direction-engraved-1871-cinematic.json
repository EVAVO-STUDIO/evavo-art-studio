    "gameGenre": "historical maritime trading role-playing game",
    "targetPlatform": "desktop and mobile",
    "viewport": { "width": 1280, "height": 720 }
  },
  "style": {
    "intent": "Create an authored 1871 New Orleans arrival cinematic in pure black-and-white engraved linework, retaining one fixed room-and-wharf language across the full shot.",
    "mustHave": [
      "historically plausible Reconstruction-era levee",
      "Mississippi steamboat and cotton-wharf construction",
      "front-on or restrained side-stage composition",
      "controlled hatching, stipple and hard silhouettes",
      "clear foreground, action lane and background separation"
    ],
    "mustAvoid": [
      "tourist postcard composition",
      "modern containers, forklifts or electric lighting",
      "fantasy pirate decoration",
      "grayscale airbrush gradients",
      "photoreal rendering",
      "different geometry between frames"
    ],
    "compositionRules": [
      "retain one stable camera and horizon across the shot",
      "separate weather, river movement, smoke and foreground occlusion where useful",
      "leave readable negative space for optional runtime captions rather than drawing text into the art"
    ],
    "antiGeneric": {
      "requiredDistinctiveMotifs": [
        "1871 New Orleans cotton-wharf labour",
        "project-specific steamboat and levee silhouettes",
        "humid Reconstruction-era maritime atmosphere"
      ],
      "prohibitedGenericMotifs": [
        "pirate flags",
        "modern skyline",
        "random cinematic lens flare",
        "AI-like decorative scrollwork",
        "unrequested readable signage"
      ],
      "prohibitUnrequestedProps": true,
      "prohibitReadableText": true,
      "prohibitWatermarks": true,
      "prohibitModernGloss": true,
      "prohibitRandomMicrodetail": true,
      "prohibitStyleDrift": true,
      "requireHistoricalPlausibility": true
    },
    "references": [
      {
        "id": "new-orleans-wharf-layout",
        "role": "composition",

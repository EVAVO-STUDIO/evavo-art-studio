{
  "schemaVersion": "1.0",
  "contractId": "brass-brine-deckhand-walk-direction",
  "presetId": "isometric-rpg-1997",
  "project": {
    "projectId": "brass-brine",
    "title": "Brass & Brine",
    "engine": "Godot",
    "engineVersion": "4.6.2",
    "gameGenre": "historical maritime trading role-playing game",
    "targetPlatform": "desktop and mobile",
    "viewport": { "width": 1280, "height": 720 },
    "worldScale": {
      "pixelsPerTile": 64,
      "characterHeightPixels": 96,
      "tileWidthPixels": 64,
      "tileHeightPixels": 32
    }
  },
  "style": {
    "intent": "Create a late-1990s isometric deckhand animation that belongs to one stable authored maritime world across every direction and frame.",
    "mustHave": [
      "clear deckhand silhouette at gameplay scale",
      "historically plausible 1871 work clothing",
      "stable coat, cap, boots and body proportions",
      "readable feet and ground contact"
    ],
    "mustAvoid": [
      "generic fantasy armour",
      "modern tactical equipment",
      "random straps, pouches or glowing accents",
      "different lighting between directions",
      "independent frame redesign"
    ],
    "materialLanguage": [
      "worn wool and canvas",
      "salt-dulled leather",
      "restrained brass and iron fittings"
    ],
    "antiGeneric": {
      "requiredDistinctiveMotifs": [
        "Reconstruction-era maritime workwear",
        "project-specific deckhand coat and cap construction"
      ],
      "prohibitedGenericMotifs": [
        "AI-like ornamental clutter",
        "fantasy pirate costume",
        "random smoke or magical atmosphere"
      ],
      "prohibitUnrequestedProps": true,
      "prohibitReadableText": true,
      "prohibitWatermarks": true,
      "prohibitModernGloss": true,
      "prohibitRandomMicrodetail": true,
      "prohibitStyleDrift": true,
      "requireHistoricalPlausibility": true
    },
    "references": [
      {
        "id": "deckhand-identity-master",
        "role": "identity",
        "uri": "artifact://projects/brass-brine/characters/deckhand/canonical-identity",
        "weight": 1,
        "rights": "EVAVO project-owned source art."
      },
      {
        "id": "brass-brine-palette",
        "role": "palette",
        "uri": "artifact://projects/brass-brine/style/palette-master",
        "weight": 1,
        "rights": "EVAVO project-owned style asset."
      },
      {
        "id": "maritime-1871-reference",
        "role": "historical",
        "uri": "reference://brass-brine/research/1871-maritime-workwear",
        "weight": 0.9,
        "rights": "Research reference only; do not copy protected artwork."
      }
    ]
  },
  "asset": {
    "assetId": "deckhand-walk",
    "family": "character",
    "purpose": "Eight-direction gameplay walk cycle with runtime clothing and equipment variants.",
    "dimensions": { "width": 96, "height": 128 },
    "transparency": "required",
    "animated": true,
    "frameCount": 8,
    "framesPerSecond": 8,
    "loop": true,
    "directionCount": 8,
    "directionNames": [
      "south",
      "south-west",
      "west",
      "north-west",
      "north",
      "north-east",
      "east",
      "south-east"
    ],
    "asymmetric": true,
    "runtimeEquipmentSwaps": true,
    "runtimeCostumeVariants": true,
    "independentEffects": true,
    "independentShadow": true,
    "needsCollision": true,
    "largeDeformations": true,
    "secondaryMotion": ["equipment"],
    "tileFootprint": { "width": 1, "height": 1 }
  },
  "outputProfileIds": ["godot-4.6.2-isometric-character"],
  "layerOverrides": [
    {
      "role": "shadow",
      "treatment": "linked-cel",
      "reason": "Retain registered shadow reuse only where the footprint genuinely remains identical."
    },
    {
      "role": "collision",
      "treatment": "engine-sidecar",
      "reason": "Collision remains deterministic Godot metadata and never visible colour artwork."
    }
  ]
}
